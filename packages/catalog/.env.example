# Required for `bun run sync -- smoke`; must be an absolute external persistent directory.
REFRAME_DATA_DIR=
# One authorized US-English IKEA product URL for the bounded prepared smoke run.
REFRAME_IKEA_SMOKE_PRODUCT_URL=
# Source-measured dimensions and placement facts for that one product. No market or category defaults exist.
REFRAME_IKEA_SMOKE_WIDTH_M=
REFRAME_IKEA_SMOKE_HEIGHT_M=
REFRAME_IKEA_SMOKE_DEPTH_M=
REFRAME_IKEA_SMOKE_CATEGORY=
REFRAME_IKEA_SMOKE_SUPPORT_TYPE=
REFRAME_IKEA_SMOKE_CACHE_PROFILES=
# Pinned build-only processor tools. They produce only external persistent artifacts.
REFRAME_BLENDER_PATH=
REFRAME_USDZIP_PATH=
REFRAME_USDCHECKER_PATH=
REFRAME_ASSET_PROCESSOR_REVISION=
