{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reframe:schema:frame-packet:1",
  "title": "Reframe FramePacket v1",
  "description": "Atomic image, calibration, pose, tracking, quality, ordering, and idempotency metadata. Binary transports must carry this JSON header and payload in one framing unit; duplicate fixed-header values must equal the JSON values byte-for-byte after canonical encoding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "session_id",
    "submap_id",
    "frame_id",
    "world_frame_id",
    "world_frame_version",
    "capture_sequence",
    "monotonic_timestamp_ns",
    "timestamp_domain",
    "coordinate_convention",
    "image",
    "intrinsics_encoded_pixels",
    "encoded_from_sensor",
    "world_from_camera",
    "tracking",
    "quality",
    "durability",
    "idempotency_key",
    "payload_sha256",
    "wire_framing"
  ],
  "properties": {
    "protocol_version": { "const": "1.0.0" },
    "session_id": { "$ref": "#/$defs/sessionId" },
    "submap_id": { "$ref": "#/$defs/submapId" },
    "frame_id": { "$ref": "#/$defs/frameId" },
    "world_frame_id": { "$ref": "#/$defs/worldId" },
    "world_frame_version": { "type": "integer", "minimum": 1 },
    "capture_sequence": {
      "type": "integer",
      "minimum": 0,
      "description": "Strictly increasing within a session; gaps are allowed when stale selected work is dropped before durability."
    },
    "monotonic_timestamp_ns": { "$ref": "#/$defs/decimalNanoseconds" },
    "timestamp_domain": { "const": "device_monotonic_boot" },
    "coordinate_convention": { "const": "RF-COORD-1" },
    "image": { "$ref": "#/$defs/image" },
    "intrinsics_encoded_pixels": { "$ref": "#/$defs/intrinsics" },
    "encoded_from_sensor": { "$ref": "#/$defs/matrix3" },
    "world_from_camera": { "$ref": "#/$defs/matrix4" },
    "tracking": { "$ref": "#/$defs/tracking" },
    "quality": { "$ref": "#/$defs/quality" },
    "durability": { "$ref": "#/$defs/durability" },
    "idempotency_key": {
      "type": "string",
      "pattern": "^frameidem_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "previous_durable_frame_id": { "anyOf": [{ "$ref": "#/$defs/frameId" }, { "type": "null" }] },
    "arkit_evidence": { "$ref": "#/$defs/arkitEvidence" },
    "payload_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "SHA-256 of the exact encoded image payload bytes for both inline and .rfcap-file transport. The RF-JCS-SHA256-1 packet digest covers this member and therefore binds metadata to those image bytes."
    },
    "wire_framing": { "$ref": "#/$defs/wireFraming" }
  },
  "$defs": {
    "sessionId": {
      "type": "string",
      "pattern": "^session_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "submapId": {
      "type": "string",
      "pattern": "^submap_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "frameId": {
      "type": "string",
      "pattern": "^frame_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "worldId": {
      "type": "string",
      "pattern": "^world_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "archiveRelativePath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$",
      "description": "Normalized forward-slash path relative to the capture root; no absolute, drive, UNC/backslash, dot, or dot-dot segments."
    },
    "decimalNanoseconds": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "description": "Decimal string prevents loss above JavaScript's safe integer range."
    },
    "finiteNumber": {
      "type": "number",
      "minimum": -3.4028234663852886e38,
      "maximum": 3.4028234663852886e38,
      "description": "Finite binary32-range JSON number. Deterministic validation must convert to IEEE-754 binary32 and apply RF-FLOAT-1 semantic and rigid-transform checks."
    },
    "wireFraming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "magic_ascii",
        "version_major",
        "version_minor",
        "byte_order",
        "fixed_header_bytes",
        "json_encoding",
        "json_header_max_bytes",
        "payload_max_bytes"
      ],
      "properties": {
        "format": { "const": "RFFP-WIRE-1" },
        "magic_ascii": { "const": "RFFP" },
        "version_major": { "const": 1 },
        "version_minor": { "const": 0 },
        "byte_order": { "const": "network_big_endian" },
        "fixed_header_bytes": { "const": 24 },
        "json_encoding": { "const": "rfc8785_jcs_utf8" },
        "json_header_max_bytes": { "const": 65536 },
        "payload_max_bytes": { "const": 16777216 }
      },
      "description": "Wire bytes are exactly: offsets 0..3 ASCII RFFP; 4 uint8 major=1; 5 uint8 minor=0; 6..7 uint16 flags=0; 8..11 uint32 JSON-header length; 12..15 uint32 payload length; 16..23 uint64 capture_sequence, all multibyte integers big-endian; then exactly the declared RFC 8785 JCS UTF-8 header bytes and exactly payload-length image bytes, with no padding/trailer. Header/payload lengths must be within the declared maxima. Fixed capture_sequence and payload length must equal JSON capture_sequence and image.payload.byte_length; payload SHA-256 must match exact payload bytes. Truncation, trailing bytes, nonzero flags, version/magic mismatch, length mismatch, or duplicate-field mismatch rejects the entire frame before journal/network acceptance."
    },
    "matrix3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "scalar_type", "math_convention", "values"],
      "properties": {
        "layout": { "const": "row_major" },
        "scalar_type": { "const": "float32" },
        "math_convention": { "const": "column_vector" },
        "values": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/finiteNumber" },
          "description": "Values and cross-language comparisons must satisfy RF-FLOAT-1."
        }
      }
    },
    "matrix4": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "scalar_type", "math_convention", "units", "values"],
      "properties": {
        "layout": { "const": "row_major" },
        "scalar_type": { "const": "float32" },
        "math_convention": { "const": "column_vector" },
        "units": { "const": "meters" },
        "values": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/finiteNumber" },
          "description": "Rigid transform validity and comparison must satisfy RF-FLOAT-1."
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codec",
        "width",
        "height",
        "orientation",
        "pixel_origin",
        "pixel_center",
        "color_space",
        "range",
        "crop_in_sensor_pixels",
        "payload"
      ],
      "properties": {
        "codec": { "enum": ["jpeg", "hevc_intra", "png"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "orientation": {
          "const": "up",
          "description": "Encoded bytes are physically rotated upright; orientation is not deferred to metadata."
        },
        "pixel_origin": { "const": "top_left" },
        "pixel_center": { "const": "half_integer" },
        "color_space": { "enum": ["srgb", "display_p3"] },
        "range": { "enum": ["full", "video"] },
        "crop_in_sensor_pixels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "$ref": "#/$defs/finiteNumber", "minimum": 0 },
            "y": { "$ref": "#/$defs/finiteNumber", "minimum": 0 },
            "width": { "$ref": "#/$defs/finiteNumber", "exclusiveMinimum": 0 },
            "height": { "$ref": "#/$defs/finiteNumber", "exclusiveMinimum": 0 }
          }
        },
        "payload": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "byte_length"],
              "properties": {
                "kind": { "const": "inline_binary_after_json" },
                "byte_length": { "type": "integer", "minimum": 1, "maximum": 16777216 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "relative_path", "sha256", "byte_length"],
              "properties": {
                "kind": { "const": "rfcap_file" },
                "relative_path": { "$ref": "#/$defs/archiveRelativePath" },
                "sha256": { "$ref": "#/$defs/sha256" },
                "byte_length": { "type": "integer", "minimum": 1, "maximum": 16777216 }
              }
            }
          ]
        }
      }
    },
    "intrinsics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fx", "fy", "cx", "cy", "width", "height", "units"],
      "properties": {
        "fx": { "$ref": "#/$defs/finiteNumber", "exclusiveMinimum": 0 },
        "fy": { "$ref": "#/$defs/finiteNumber", "exclusiveMinimum": 0 },
        "cx": { "$ref": "#/$defs/finiteNumber" },
        "cy": { "$ref": "#/$defs/finiteNumber" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "units": { "const": "encoded_pixels" }
      }
    },
    "tracking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": { "enum": ["normal", "limited", "not_available"] },
        "reason": {
          "enum": [
            "none",
            "initializing",
            "excessive_motion",
            "insufficient_features",
            "relocalizing",
            "camera_unavailable",
            "unknown"
          ]
        }
      },
      "oneOf": [
        {
          "properties": { "state": { "const": "normal" }, "reason": { "const": "none" } },
          "required": ["state", "reason"]
        },
        {
          "properties": {
            "state": { "const": "limited" },
            "reason": {
              "enum": [
                "initializing",
                "excessive_motion",
                "insufficient_features",
                "relocalizing",
                "unknown"
              ]
            }
          },
          "required": ["state", "reason"]
        },
        {
          "properties": {
            "state": { "const": "not_available" },
            "reason": { "enum": ["camera_unavailable", "unknown"] }
          },
          "required": ["state", "reason"]
        }
      ]
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["motion_score", "blur_score", "exposure_score", "selected_reason"],
      "properties": {
        "motion_score": { "$ref": "#/$defs/finiteNumber", "minimum": 0, "maximum": 1 },
        "blur_score": { "$ref": "#/$defs/finiteNumber", "minimum": 0, "maximum": 1 },
        "exposure_score": { "$ref": "#/$defs/finiteNumber", "minimum": 0, "maximum": 1 },
        "selected_reason": {
          "enum": ["cadence", "view_novelty", "keyframe", "user_event", "recovery"]
        }
      }
    },
    "durability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "image_and_metadata_durable", "journal_sequence", "network_eligible"],
      "properties": {
        "state": {
          "const": "network_eligible",
          "description": "A live/persisted FramePacket snapshot is exposed only at the fourth lifecycle state, after image/metadata durability and journal append. Server acknowledgement is a later CON-002 event."
        },
        "image_and_metadata_durable": { "const": true },
        "journal_sequence": { "type": "integer", "minimum": 0 },
        "network_eligible": { "const": true }
      }
    },
    "arkitEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "planes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["plane_id", "alignment", "world_from_plane", "extent_m"],
            "properties": {
              "plane_id": {
                "type": "string",
                "pattern": "^surface_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "alignment": { "enum": ["horizontal", "vertical"] },
              "world_from_plane": { "$ref": "#/$defs/matrix4" },
              "extent_m": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "$ref": "#/$defs/finiteNumber", "minimum": 0 }
              }
            }
          }
        },
        "raw_feature_points": {
          "type": "array",
          "description": "Ephemeral alignment evidence only; never durable canonical geometry.",
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "$ref": "#/$defs/finiteNumber" }
          }
        }
      }
    }
  }
}
