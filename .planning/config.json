{
  "runtime": "codex",
  "resolve_model_ids": false,
  "model_profile": "balanced",
  "model_profile_overrides": {
    "codex": {
      "opus": "gpt-5.6-sol",
      "sonnet": "gpt-5.6-terra",
      "haiku": "gpt-5.6-luna"
    }
  },
  "model_overrides": {
    "gsd-debugger": "gpt-5.6-sol",
    "gsd-security-auditor": "gpt-5.6-sol"
  },
  "effort": {
    "routing_tier_defaults": {
      "light": "low",
      "standard": "high",
      "heavy": "xhigh"
    }
  },
  "mode": "interactive",
  "granularity": "standard",
  "commit_docs": true,
  "parallelization": {
    "enabled": true,
    "plan_level": true,
    "task_level": false,
    "skip_checkpoints": false,
    "max_concurrent_agents": 2,
    "min_plans_for_parallel": 2
  },
  "search_gitignored": false,
  "firecrawl": true,
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "nyquist_validation": true,
    "auto_advance": false,
    "node_repair": true,
    "node_repair_budget": 2,
    "ui_phase": true,
    "ui_safety_gate": true,
    "ai_integration_phase": true,
    "api_coverage_gate": true,
    "context_guard_mode": "warn",
    "text_mode": false,
    "research_before_questions": true,
    "discuss_mode": "discuss",
    "skip_discuss": false,
    "code_review": true,
    "code_review_depth": "deep",
    "pattern_mapper": true,
    "plan_bounce": false,
    "auto_prune_state": false,
    "post_planning_gaps": true,
    "security_enforcement": true,
    "security_asvs_level": 2,
    "security_block_on": "high",
    "tdd_mode": true,
    "ui_review": true,
    "use_worktrees": false,
    "_auto_chain_active": false,
    "subagent_timeout": 900000
  },
  "hooks": {
    "context_warnings": true
  },
  "plan_review": {
    "source_grounding": true,
    "source_grounding_authority": "grep"
  },
  "intel": {
    "enabled": false
  },
  "graphify": {
    "enabled": false,
    "auto_update": false
  },
  "git": {
    "branching_strategy": "none",
    "create_tag": true
  },
  "context_window": 1000000,
  "features": {
    "thinking_partner": true
  }
}
