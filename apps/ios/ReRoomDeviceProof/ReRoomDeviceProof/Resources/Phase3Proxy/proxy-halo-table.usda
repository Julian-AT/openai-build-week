#usda 1.0
(
    defaultPrim = "HaloSideTable"
    metersPerUnit = 1
    upAxis = "Y"
    customLayerData = {
        string qualification = "hackathon_repo_owned_demo_proxy_only"
        string proxy_id = "asset_proxy-halo-table-hackathon"
    }
)

def Xform "HaloSideTable" (
    kind = "component"
)
{
    custom string qualification = "Repository-owned hackathon proxy; GATE-011 pending"

    def Cube "Top"
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.95, 0.64, 0.18)]
        double3 xformOp:scale = (0.62, 0.08, 0.62)
        double3 xformOp:translate = (0, 0.62, 0)
        uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:translate"]
    }

    def Cube "Pedestal"
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.18, 0.16, 0.14)]
        double3 xformOp:scale = (0.12, 0.58, 0.12)
        double3 xformOp:translate = (0, 0.29, 0)
        uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:translate"]
    }

    def Cube "Base"
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.30, 0.27, 0.23)]
        double3 xformOp:scale = (0.42, 0.06, 0.42)
        double3 xformOp:translate = (0, 0.03, 0)
        uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:translate"]
    }
}
