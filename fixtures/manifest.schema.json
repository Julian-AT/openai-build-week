{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reroom:test-schema:fixture-manifest:1",
  "title": "FixtureManifestV1",
  "description": "Closed test-only manifest for an immutable ReRoom oracle revision. Case arrays are semantically required to be strictly increasing by case_id; generators may propose a new revision but are never an oracle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "fixture_revision",
    "subject",
    "oracle",
    "limits",
    "schema_hashes",
    "cases"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "fixture_id": { "enum": ["FX-CONTRACT-001", "FX-JCS-001", "FX-COORD-001"] },
    "fixture_revision": { "type": "string", "pattern": "^rev-[0-9]{3}$" },
    "subject": { "enum": ["CON-001-CON-005", "RR-JCS-SHA256-1", "RR-COORD-1"] },
    "oracle": { "$ref": "#/$defs/oraclePolicy" },
    "limits": { "$ref": "#/$defs/limits" },
    "schema_hashes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/schemaHash" },
      "allOf": [
        { "contains": { "properties": { "contract_id": { "const": "CON-001" } }, "required": ["contract_id"] }, "minContains": 1 },
        { "contains": { "properties": { "contract_id": { "const": "CON-002" } }, "required": ["contract_id"] }, "minContains": 1 },
        { "contains": { "properties": { "contract_id": { "const": "CON-003" } }, "required": ["contract_id"] }, "minContains": 1 },
        { "contains": { "properties": { "contract_id": { "const": "CON-004" } }, "required": ["contract_id"] }, "minContains": 1 },
        { "contains": { "properties": { "contract_id": { "const": "CON-005" } }, "required": ["contract_id"] }, "minContains": 1 }
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/fixtureCase" },
      "description": "FixtureCaseV1 rows. A loader must reject duplicate or non-lexicographic case_id values before executing a case."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "fixture_id": { "const": "FX-CONTRACT-001" } }, "required": ["fixture_id"] },
      "then": { "properties": { "subject": { "const": "CON-001-CON-005" } } }
    },
    {
      "if": { "properties": { "fixture_id": { "const": "FX-JCS-001" } }, "required": ["fixture_id"] },
      "then": { "properties": { "subject": { "const": "RR-JCS-SHA256-1" } } }
    },
    {
      "if": { "properties": { "fixture_id": { "const": "FX-COORD-001" } }, "required": ["fixture_id"] },
      "then": { "properties": { "subject": { "const": "RR-COORD-1" } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$",
      "description": "ASCII archive-relative path. The 240-character bound is therefore also a 240-byte UTF-8 bound."
    },
    "oraclePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source", "expected_generation", "case_order", "generator_role"],
      "properties": {
        "status": { "const": "immutable" },
        "source": { "const": "checked_in" },
        "expected_generation": { "const": "forbidden_during_verification" },
        "case_order": { "const": "lexicographic_case_id" },
        "generator_role": { "const": "proposal_only" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_document_depth", "max_cases", "max_file_bytes", "max_path_bytes"],
      "properties": {
        "max_document_depth": { "const": 64 },
        "max_cases": { "const": 2048 },
        "max_file_bytes": { "const": 33554432 },
        "max_path_bytes": { "const": 240 }
      },
      "description": "A fixture loader enforces these limits before recursive decoding or payload access."
    },
    "schemaHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "schema_id", "relative_path", "sha256"],
      "properties": {
        "contract_id": { "enum": ["CON-001", "CON-002", "CON-003", "CON-004", "CON-005"] },
        "schema_id": {
          "enum": [
            "urn:reroom:schema:frame-packet:1",
            "urn:reroom:schema:rrcap-manifest:1",
            "urn:reroom:schema:scene-state:1",
            "urn:reroom:schema:edit-artifacts:1",
            "urn:reroom:schema:transaction:1"
          ]
        },
        "relative_path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "description": "Deterministic validation also requires the contract_id, schema_id, and canonical path to be the registered matching tuple."
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "media_type", "byte_length", "sha256"],
      "properties": {
        "relative_path": { "$ref": "#/$defs/relativePath" },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "byte_length": { "type": "integer", "minimum": 0, "maximum": 33554432 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "expectedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "relative_path", "media_type", "byte_length", "sha256"],
      "properties": {
        "kind": { "enum": ["canonical_bytes", "digest", "wire_bytes", "projected_pixels", "matrix", "runner_consensus"] },
        "relative_path": { "$ref": "#/$defs/relativePath" },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "byte_length": { "type": "integer", "minimum": 0, "maximum": 33554432 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "value_sha256": { "$ref": "#/$defs/sha256", "description": "Exact lowercase digest value when kind is digest; sha256 still protects the checked-in file bytes." }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "digest" } }, "required": ["kind"] },
          "then": { "required": ["value_sha256"] },
          "else": { "not": { "required": ["value_sha256"] } }
        }
      ]
    },
    "rejectionClass": {
      "enum": [
        "json_parse",
        "duplicate_name",
        "invalid_unicode",
        "schema_validation",
        "unsupported_contract_version",
        "unknown_property",
        "invalid_identity",
        "invalid_path",
        "numeric_out_of_range",
        "semantic_invariant",
        "digest_mismatch",
        "unsupported_algorithm",
        "unsupported_scope",
        "wire_magic",
        "wire_version",
        "wire_flags",
        "wire_length",
        "wire_sequence",
        "wire_truncated",
        "wire_trailing_bytes",
        "coordinate_invalid"
      ]
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "rejection_class", "artifacts"],
      "properties": {
        "verdict": { "enum": ["accept", "reject"] },
        "rejection_class": { "oneOf": [{ "$ref": "#/$defs/rejectionClass" }, { "type": "null" }] },
        "artifacts": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/expectedArtifact" } }
      },
      "allOf": [
        {
          "if": { "properties": { "verdict": { "const": "accept" } }, "required": ["verdict"] },
          "then": { "properties": { "rejection_class": { "type": "null" } } },
          "else": {
            "properties": {
              "rejection_class": { "$ref": "#/$defs/rejectionClass" },
              "artifacts": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "fixtureCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "case_kind", "input", "expected", "immutable"],
      "properties": {
        "case_id": { "type": "string", "minLength": 3, "maxLength": 96, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "case_kind": { "enum": ["json_instance", "json_mutation", "raw_json", "wire_bytes", "wire_mutation", "coordinate_vector", "digest_scope"] },
        "input": { "$ref": "#/$defs/fileRef" },
        "expected": { "$ref": "#/$defs/expected" },
        "immutable": { "const": true }
      }
    }
  }
}
