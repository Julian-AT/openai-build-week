#!/usr/bin/env python3
"""Produce fresh, revision-bound Swift/JavaScript/Python agreement evidence."""

from __future__ import annotations

import hashlib
import json
import os
import platform
import re
import shutil
import stat
import subprocess
import sys
import tempfile
from pathlib import Path


BOUND_REVISION = "a5bff6896188dcac9397c48ce1a6820a7196011a"
IMPLEMENTATION_REVISION = f"git:{BOUND_REVISION}"
COMMAND_TIMEOUT_SECONDS = 120
PUBLISHER_RELATIVE_PATH = "scripts/run-three-runtime-agreement"
NODE_PACKAGE_RELATIVE_PATH = "tools/javascript/package.json"
SWIFT_PACKAGE_ROOT_RELATIVE_PATH = "ios/Packages/ReRoomContracts"
SWIFT_PACKAGE_MANIFEST_RELATIVE_PATH = (
    f"{SWIFT_PACKAGE_ROOT_RELATIVE_PATH}/Package.swift"
)
SWIFT_VERSION_MANIFEST_PATTERN = re.compile(
    r"Package@swift-[0-9]+(?:\.[0-9]+){0,2}\.swift"
)
CANONICAL_TEST_IDS = {
    "FX-CONTRACT-001": ("TST-CONTRACT-001", "TST-CONTRACT-002"),
    "FX-JCS-001": ("TST-DIGEST-001",),
    "FX-COORD-001": ("TST-COORD-001", "TST-COORD-002"),
}
MANIFESTS = (
    (
        "contract",
        "FX-CONTRACT-001",
        "fixtures/contracts/1.0.0/rev-001/manifest.json",
        "contract-agreement.json",
        ("NFR-CONTRACT-001",),
        CANONICAL_TEST_IDS["FX-CONTRACT-001"],
    ),
    (
        "jcs",
        "FX-JCS-001",
        "fixtures/policies/RR-JCS-SHA256-1/rev-001/manifest.json",
        "jcs-agreement.json",
        ("NFR-CONTRACT-001",),
        CANONICAL_TEST_IDS["FX-JCS-001"],
    ),
    (
        "coordinate",
        "FX-COORD-001",
        "fixtures/policies/RR-COORD-1/rev-001/manifest.json",
        "coordinate-agreement.json",
        ("NFR-COORD-001",),
        CANONICAL_TEST_IDS["FX-COORD-001"],
    ),
)
RUNNERS = {
    "swift": ("reroom-swift-reference", "1.0.0"),
    "javascript": ("reroom-javascript-reference", "1.0.0"),
    "python": ("reroom-python-reference", "1.0.0"),
}
BOUND_SOURCE_SCOPES = (
    "fixtures",
    "docs/contracts",
    "ios/Packages/ReRoomContracts/Package.swift",
    "ios/Packages/ReRoomContracts/Package.resolved",
    "ios/Packages/ReRoomContracts/Sources/ReRoomContracts",
    "ios/Packages/ReRoomContracts/Sources/ReRoomContractRunner",
    "tools/javascript/package.json",
    "tools/javascript/package-lock.json",
    "tools/javascript/src",
    "tools/python/requirements.in",
    "tools/python/requirements.lock",
    "tools/python/reroom_verify",
    "tools/verify/compare_results.py",
    "tools/verify/fixtures",
)


class AgreementError(RuntimeError):
    """A sanitized fail-closed agreement harness error."""


def _repo_root() -> Path:
    return Path(__file__).resolve().parents[1]


def _sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def _run(
    command: list[str],
    *,
    root: Path,
    label: str,
    timeout: int = COMMAND_TIMEOUT_SECONDS,
) -> subprocess.CompletedProcess[str]:
    try:
        with tempfile.TemporaryDirectory(
            prefix="reroom-three-runtime-pycache-"
        ) as python_cache:
            environment = dict(os.environ, PYTHONPYCACHEPREFIX=python_cache)
            completed = subprocess.run(
                command,
                cwd=root,
                env=environment,
                check=False,
                capture_output=True,
                text=True,
                timeout=timeout,
            )
    except (OSError, subprocess.SubprocessError) as error:
        raise AgreementError(f"{label} could not execute") from error
    if completed.returncode != 0:
        diagnostic = completed.stderr.strip().splitlines()
        detail = diagnostic[-1] if diagnostic else f"exit {completed.returncode}"
        raise AgreementError(f"{label} failed: {detail}")
    return completed


def _resolve_executable(value: str | Path, label: str) -> Path:
    text = os.fspath(value)
    candidate = shutil.which(text) if os.sep not in text else text
    if candidate is None:
        raise AgreementError(f"{label} executable is unavailable")
    path = Path(candidate).expanduser().absolute()
    if not path.is_file() or not os.access(path, os.X_OK):
        raise AgreementError(f"{label} executable is unavailable")
    return path


def _require_bound_sources(root: Path) -> list[dict[str, str]]:
    _run(
        ["git", "cat-file", "-e", f"{BOUND_REVISION}^{{commit}}"],
        root=root,
        label="bound implementation revision",
        timeout=10,
    )
    listing = _run(
        ["git", "ls-tree", "-r", "-z", BOUND_REVISION, "--", *BOUND_SOURCE_SCOPES],
        root=root,
        label="bound implementation source listing",
        timeout=20,
    )

    expected: dict[str, str] = {}
    for entry in listing.stdout.split("\0"):
        if not entry:
            continue
        try:
            metadata, relative = entry.split("\t", 1)
            mode, object_type, _ = metadata.split(" ", 2)
        except ValueError as error:
            raise AgreementError("bound implementation source listing is malformed") from error
        if object_type != "blob" or mode not in {"100644", "100755"}:
            raise AgreementError("a bound implementation source is not a regular file")
        expected[relative] = mode
    if not expected:
        raise AgreementError("bound implementation source set is empty")

    directory_scopes = tuple(
        scope.rstrip("/")
        for scope in BOUND_SOURCE_SCOPES
        if any(relative.startswith(f"{scope.rstrip('/')}/") for relative in expected)
    )
    expected_directories = set(directory_scopes)
    for relative in expected:
        for scope in directory_scopes:
            if not relative.startswith(f"{scope}/"):
                continue
            parent = Path(relative).parent
            while parent.as_posix().startswith(scope):
                expected_directories.add(parent.as_posix())
                if parent.as_posix() == scope:
                    break
                parent = parent.parent

    def is_isolated_python_cache(relative: str, *, directory: bool) -> bool:
        parts = Path(relative).parts
        if "__pycache__" not in parts:
            return False
        return directory or relative.endswith(".pyc")

    for scope in directory_scopes:
        scope_path = root / scope
        try:
            scope_mode = scope_path.lstat().st_mode
        except OSError as error:
            raise AgreementError("a bound implementation source is unavailable") from error
        if not stat.S_ISDIR(scope_mode):
            raise AgreementError("a bound implementation source directory is not regular")
        for current, directory_names, file_names in os.walk(
            scope_path, topdown=True, followlinks=False
        ):
            current_path = Path(current)
            for name in directory_names:
                path = current_path / name
                relative = path.relative_to(root).as_posix()
                try:
                    actual_mode = path.lstat().st_mode
                except OSError as error:
                    raise AgreementError("a bound implementation source is unavailable") from error
                if not stat.S_ISDIR(actual_mode):
                    raise AgreementError("a bound implementation source is not a regular file")
                if relative not in expected_directories and not is_isolated_python_cache(
                    relative, directory=True
                ):
                    raise AgreementError(
                        "an implementation source exists outside the bound implementation revision"
                    )
            for name in file_names:
                path = current_path / name
                relative = path.relative_to(root).as_posix()
                try:
                    actual_mode = path.lstat().st_mode
                except OSError as error:
                    raise AgreementError("a bound implementation source is unavailable") from error
                if not stat.S_ISREG(actual_mode):
                    raise AgreementError("a bound implementation source is not a regular file")
                if relative not in expected and not is_isolated_python_cache(
                    relative, directory=False
                ):
                    raise AgreementError(
                        "an implementation source exists outside the bound implementation revision"
                    )

    records: list[dict[str, str]] = []
    executable_bits = stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH
    for relative, expected_mode in sorted(expected.items()):
        path = root / relative
        try:
            actual_mode = path.lstat().st_mode
        except OSError as error:
            raise AgreementError("a bound implementation source is unavailable") from error
        if not stat.S_ISREG(actual_mode):
            raise AgreementError("a bound implementation source is not a regular file")
        expected_executable = expected_mode == "100755"
        actual_executable = bool(actual_mode & executable_bits)
        if actual_executable != expected_executable:
            raise AgreementError(
                "a bound implementation source mode differs from the bound revision"
            )
        records.append({"relative_path": relative, "sha256": _sha256(path.read_bytes())})

    comparison = subprocess.run(
        ["git", "diff", "--quiet", BOUND_REVISION, "--", *BOUND_SOURCE_SCOPES],
        cwd=root,
        check=False,
        capture_output=True,
        text=True,
        timeout=20,
    )
    if comparison.returncode != 0:
        raise AgreementError("bound implementation sources differ from their recorded revision")
    return records


def _source_tree_digest(records: list[dict[str, str]]) -> str:
    scope = "".join(
        f"{record['relative_path']}\0{record['sha256']}\n" for record in records
    ).encode("utf-8")
    return _sha256(scope)


def _require_swift_package_manifest(
    root: Path, *, source_records: list[dict[str, str]]
) -> dict[str, str]:
    package_root = root / SWIFT_PACKAGE_ROOT_RELATIVE_PATH
    try:
        package_root_mode = package_root.lstat().st_mode
    except OSError as error:
        raise AgreementError("Swift package root is unavailable") from error
    if not stat.S_ISDIR(package_root_mode):
        raise AgreementError("Swift package root is not a regular directory")

    try:
        with os.scandir(package_root) as scan:
            entries = tuple(scan)
    except OSError as error:
        raise AgreementError("Swift package root cannot be enumerated") from error
    for entry in entries:
        if SWIFT_VERSION_MANIFEST_PATTERN.fullmatch(entry.name):
            raise AgreementError(
                "a version-specific Swift package manifest can override the exact bound Package.swift"
            )

    matching_records = [
        record
        for record in source_records
        if record.get("relative_path") == SWIFT_PACKAGE_MANIFEST_RELATIVE_PATH
    ]
    if len(matching_records) != 1:
        raise AgreementError("the exact bound Swift package manifest is unavailable")
    selected = matching_records[0]
    manifest_path = root / SWIFT_PACKAGE_MANIFEST_RELATIVE_PATH
    try:
        manifest_mode = manifest_path.lstat().st_mode
        manifest_sha256 = _sha256(manifest_path.read_bytes())
    except OSError as error:
        raise AgreementError("the exact bound Swift package manifest is unavailable") from error
    if not stat.S_ISREG(manifest_mode) or manifest_sha256 != selected.get("sha256"):
        raise AgreementError("the exact bound Swift package manifest is invalid")
    return {
        "relative_path": SWIFT_PACKAGE_MANIFEST_RELATIVE_PATH,
        "sha256": manifest_sha256,
    }


def _require_execution_bindings_unchanged(
    root: Path,
    *,
    initial_source_records: list[dict[str, str]],
    initial_swift_package_manifest: dict[str, str],
    initial_publisher_sha256: str,
) -> None:
    final_source_records = _require_bound_sources(root)
    if final_source_records != initial_source_records:
        raise AgreementError("bound implementation sources changed during agreement execution")
    final_swift_package_manifest = _require_swift_package_manifest(
        root, source_records=final_source_records
    )
    if final_swift_package_manifest != initial_swift_package_manifest:
        raise AgreementError("Swift package manifest changed during agreement execution")
    final_publisher_sha256 = _sha256((root / PUBLISHER_RELATIVE_PATH).read_bytes())
    if final_publisher_sha256 != initial_publisher_sha256:
        raise AgreementError("publisher changed during agreement execution")


def _oracle_hashes(root: Path) -> dict[str, str]:
    hashes: dict[str, str] = {}
    for directory in (root / "fixtures", root / "docs/contracts"):
        for path in sorted(directory.rglob("*")):
            if path.is_file():
                hashes[str(path.relative_to(root))] = _sha256(path.read_bytes())
    return hashes


def _read_json(path: Path, label: str) -> dict:
    if not path.is_file() or not (0 < path.stat().st_size <= 33_554_432):
        raise AgreementError(f"{label} is missing or outside its bound")
    try:
        value = json.loads(path.read_bytes())
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise AgreementError(f"{label} is malformed") from error
    if not isinstance(value, dict):
        raise AgreementError(f"{label} root is invalid")
    return value


def _validate_runner_identity(result: dict, runtime: str) -> None:
    expected_name, expected_version = RUNNERS[runtime]
    runner = result.get("runner")
    if not isinstance(runner, dict) or (
        runner.get("runtime"), runner.get("name"), runner.get("version")
    ) != (runtime, expected_name, expected_version):
        raise AgreementError(f"{runtime} runner identity is invalid")
    if runner.get("implementation_revision") != IMPLEMENTATION_REVISION:
        raise AgreementError(f"{runtime} runner revision is not bound")


def _version(command: list[str], root: Path, label: str) -> str:
    completed = _run(command, root=root, label=label, timeout=20)
    lines = (completed.stdout or completed.stderr).strip().splitlines()
    if not lines:
        raise AgreementError(f"{label} version is unavailable")
    return lines[0]


def _declared_node_version(root: Path) -> str:
    package = _read_json(
        root / NODE_PACKAGE_RELATIVE_PATH, "bound JavaScript package metadata"
    )
    engines = package.get("engines")
    version = engines.get("node") if isinstance(engines, dict) else None
    if not isinstance(version, str) or re.fullmatch(
        r"(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)", version
    ) is None:
        raise AgreementError("bound JavaScript package must declare one exact Node.js version")
    return f"v{version}"


def _require_locked_node(root: Path, node: Path) -> str:
    expected = _declared_node_version(root)
    actual = _version([str(node), "--version"], root, "Node.js")
    if actual != expected:
        raise AgreementError(
            f"Node.js runtime {actual} does not match the bound exact version {expected}"
        )
    return actual


def _environment(
    root: Path, *, node_version: str, python: Path
) -> dict[str, str]:
    product = _version(["sw_vers", "-productVersion"], root, "operating system version")
    build = _version(["sw_vers", "-buildVersion"], root, "operating system build")
    return {
        "operating_system": f"macOS {product} build {build}",
        "architecture": platform.machine(),
        "swift": _version(["swift", "--version"], root, "Swift"),
        "node": node_version,
        "python": _version([str(python), "--version"], root, "Python"),
        "command": "scripts/run-three-runtime-agreement",
        "evaluator": "tools/verify/compare_results.py compare --require-runtime swift --require-runtime javascript --require-runtime python",
    }


def _raw_result_record(path: Path, result: dict) -> dict[str, object]:
    data = path.read_bytes()
    runner = result["runner"]
    return {
        "runner_name": runner["name"],
        "runner_version": runner["version"],
        "implementation_revision": runner["implementation_revision"],
        "byte_length": len(data),
        "sha256": _sha256(data),
        "result_digest_sha256": result["result_digest_sha256"],
    }


def _commands(relative_manifest: str) -> dict[str, object]:
    common = (
        f"--manifest {relative_manifest} --output {{isolated_output}} "
        f"--repo-root {{repository_root}} --implementation-revision {IMPLEMENTATION_REVISION}"
    )
    return {
        "swift": f"ReRoomContractRunner {common}",
        "javascript": f"node tools/javascript/src/runner.mjs {common}",
        "python": f".venv/bin/python -m tools.python.reroom_verify.runner {common}",
        "comparator": (
            f"python3 tools/verify/compare_results.py compare --manifest {relative_manifest} "
            "--result {swift_output} --result {javascript_output} --result {python_output} "
            "--require-runtime swift --require-runtime javascript --require-runtime python"
        ),
        "isolation": "exclusive temporary directory; output files must not pre-exist",
    }


def _build_report(
    *,
    stem: str,
    fixture_id: str,
    relative_manifest: str,
    manifest: dict,
    raw_paths: dict[str, Path],
    results: dict[str, dict],
    requirements: tuple[str, ...],
    tests: tuple[str, ...],
    environment: dict[str, str],
    source_records: list[dict[str, str]],
    source_digest: str,
    swift_package_manifest: dict[str, str],
    evaluator_sha256: str,
    manifest_schema_sha256: str,
    result_schema_sha256: str,
    publisher_sha256: str,
) -> dict[str, object]:
    swift_cases = results["swift"]["case_results"]
    case_count = len(swift_cases)
    accepted = sum(item["verdict"] == "accept" for item in swift_cases)
    rejected = case_count - accepted
    manifest_bytes = (Path(relative_manifest)).read_bytes()
    schema_hashes = [
        {
            "contract_id": item["contract_id"],
            "schema_id": item["schema_id"],
            "relative_path": item["relative_path"],
            "sha256": item["sha256"],
        }
        for item in manifest["schema_hashes"]
    ]
    return {
        "schema_version": "1.0.0",
        "evidence_id": f"evidence_three_runtime_{stem}_20260717_007",
        "classification": "MEASURED",
        "requirement_ids": list(requirements),
        "test_ids": list(tests),
        "fixture": {
            "fixture_id": fixture_id,
            "fixture_revision": manifest["fixture_revision"],
            "manifest_relative_path": relative_manifest,
            "manifest_sha256": _sha256(manifest_bytes),
            "case_count": len(manifest["cases"]),
            "schema_hashes": schema_hashes,
            "manifest_schema_sha256": manifest_schema_sha256,
            "runner_result_schema_sha256": result_schema_sha256,
        },
        "implementation": {
            "revision": IMPLEMENTATION_REVISION,
            "revision_scope": "exact bound git revision plus the recorded source-tree digest",
            "source_tree_digest_algorithm": "SHA-256 over sorted relative_path NUL sha256 LF records",
            "source_tree_sha256": source_digest,
            "source_file_count": len(source_records),
            "source_scopes": list(BOUND_SOURCE_SCOPES),
            "swift_package_manifest": swift_package_manifest,
        },
        "raw_results": {
            runtime: _raw_result_record(raw_paths[runtime], results[runtime])
            for runtime in ("swift", "javascript", "python")
        },
        "agreement": {
            "runtime_count": 3,
            "case_count": case_count,
            "accepted": accepted,
            "rejected": rejected,
            "missing_cases": 0,
            "extra_cases": 0,
            "verdict_disagreements": 0,
            "rejection_class_disagreements": 0,
            "artifact_disagreements": 0,
            "oracle_mismatches": 0,
            "metric_calculation": (
                "compare each runtime's exact ordered case_results against the immutable oracle "
                "and each other; count missing, extra, verdict, rejection-class, artifact, and oracle mismatches"
            ),
            "verdict": "pass",
        },
        "evaluator": {
            "relative_path": "tools/verify/compare_results.py",
            "sha256": evaluator_sha256,
            "required_runtimes": ["swift", "javascript", "python"],
        },
        "publisher": {
            "relative_path": PUBLISHER_RELATIVE_PATH,
            "sha256": publisher_sha256,
        },
        "commands": _commands(relative_manifest),
        "environment": environment,
        "reproduction": {
            "command": "scripts/run-three-runtime-agreement",
            "success_condition": "fresh raw-result SHA-256 digests and the complete report bytes reproduce exactly",
            "report_write_policy": "all three comparisons pass before any report is atomically replaced",
        },
        "limitations": [
            "This evidence covers the immutable host-runtime corpus only; it is not physical-device, signing, ARKit, compositor, or thermal evidence.",
            "Any bound source or oracle change requires a new implementation revision and new evidence revision.",
        ],
    }


def _atomic_write_reports(targets: dict[Path, bytes]) -> None:
    temporary_paths: list[tuple[Path, Path]] = []
    try:
        for target, data in targets.items():
            descriptor, temporary_name = tempfile.mkstemp(
                prefix=f".{target.name}.", dir=target.parent
            )
            temporary = Path(temporary_name)
            temporary_paths.append((target, temporary))
            with os.fdopen(descriptor, "wb") as handle:
                handle.write(data)
                handle.flush()
                os.fsync(handle.fileno())
        for target, temporary in temporary_paths:
            os.replace(temporary, target)
        directory_descriptor = os.open(next(iter(targets)).parent, os.O_RDONLY)
        try:
            os.fsync(directory_descriptor)
        finally:
            os.close(directory_descriptor)
    finally:
        for _, temporary in temporary_paths:
            if temporary.exists():
                temporary.unlink()


def run() -> tuple[str, ...]:
    root = _repo_root()
    os.chdir(root)
    publisher_sha256 = _sha256((root / PUBLISHER_RELATIVE_PATH).read_bytes())
    node = _resolve_executable("node", "node")
    python = _resolve_executable(root / ".venv/bin/python", "locked Python")
    source_records = _require_bound_sources(root)
    swift_package_manifest = _require_swift_package_manifest(
        root, source_records=source_records
    )
    node_version = _require_locked_node(root, node)
    source_digest = _source_tree_digest(source_records)
    oracle_before = _oracle_hashes(root)
    environment = _environment(root, node_version=node_version, python=python)

    _run(
        ["swift", "build", "--package-path", "ios/Packages/ReRoomContracts", "--product", "ReRoomContractRunner"],
        root=root,
        label="Swift contract runner build",
    )
    binary_directory = _run(
        ["swift", "build", "--package-path", "ios/Packages/ReRoomContracts", "--show-bin-path"],
        root=root,
        label="Swift binary path",
    ).stdout.strip()
    swift_runner = _resolve_executable(
        Path(binary_directory) / "ReRoomContractRunner", "Swift contract runner"
    )
    comparator = root / "tools/verify/compare_results.py"
    evaluator_sha256 = _sha256(comparator.read_bytes())
    manifest_schema_sha256 = _sha256((root / "fixtures/manifest.schema.json").read_bytes())
    result_schema_sha256 = _sha256((root / "fixtures/runner-result.schema.json").read_bytes())

    reports: dict[Path, bytes] = {}
    fixture_ids: list[str] = []
    with tempfile.TemporaryDirectory(prefix="reroom-three-runtime-") as temporary_name:
        temporary = Path(temporary_name)
        for stem, fixture_id, relative_manifest, report_name, requirements, tests in MANIFESTS:
            manifest_path = root / relative_manifest
            manifest = _read_json(manifest_path, f"{fixture_id} manifest")
            if manifest.get("fixture_id") != fixture_id:
                raise AgreementError(f"{fixture_id} manifest identity is invalid")
            raw_paths = {
                runtime: temporary / f"{stem}.{runtime}.json" for runtime in RUNNERS
            }
            common = [
                "--manifest", str(manifest_path),
                "--repo-root", str(root),
                "--implementation-revision", IMPLEMENTATION_REVISION,
            ]
            _run(
                [str(swift_runner), *common, "--output", str(raw_paths["swift"])],
                root=root,
                label=f"{fixture_id} Swift runner",
            )
            _run(
                [
                    str(node), str(root / "tools/javascript/src/runner.mjs"),
                    *common, "--output", str(raw_paths["javascript"]),
                ],
                root=root,
                label=f"{fixture_id} JavaScript runner",
            )
            _run(
                [
                    str(python), "-m", "tools.python.reroom_verify.runner",
                    *common, "--output", str(raw_paths["python"]),
                ],
                root=root,
                label=f"{fixture_id} Python runner",
            )
            results = {
                runtime: _read_json(path, f"{fixture_id} {runtime} result")
                for runtime, path in raw_paths.items()
            }
            for runtime, result in results.items():
                _validate_runner_identity(result, runtime)
            _run(
                [
                    str(python), str(comparator), "compare",
                    "--manifest", str(manifest_path),
                    "--result", str(raw_paths["swift"]),
                    "--result", str(raw_paths["javascript"]),
                    "--result", str(raw_paths["python"]),
                    "--require-runtime", "swift",
                    "--require-runtime", "javascript",
                    "--require-runtime", "python",
                ],
                root=root,
                label=f"{fixture_id} three-runtime comparator",
            )
            report = _build_report(
                stem=stem,
                fixture_id=fixture_id,
                relative_manifest=relative_manifest,
                manifest=manifest,
                raw_paths=raw_paths,
                results=results,
                requirements=requirements,
                tests=tests,
                environment=environment,
                source_records=source_records,
                source_digest=source_digest,
                swift_package_manifest=swift_package_manifest,
                evaluator_sha256=evaluator_sha256,
                manifest_schema_sha256=manifest_schema_sha256,
                result_schema_sha256=result_schema_sha256,
                publisher_sha256=publisher_sha256,
            )
            reports[root / "evidence/compatibility" / report_name] = (
                json.dumps(report, indent=2, sort_keys=True).encode("utf-8") + b"\n"
            )
            fixture_ids.append(fixture_id)

    if _oracle_hashes(root) != oracle_before:
        raise AgreementError("oracle files changed during agreement execution")
    _require_execution_bindings_unchanged(
        root,
        initial_source_records=source_records,
        initial_swift_package_manifest=swift_package_manifest,
        initial_publisher_sha256=publisher_sha256,
    )
    _atomic_write_reports(reports)
    return tuple(fixture_ids)


def _verify_reports(
    root: Path, *, report_directory: Path | None = None
) -> tuple[str, ...]:
    reports = report_directory or root / "evidence/compatibility"
    expected_publisher = {
        "relative_path": PUBLISHER_RELATIVE_PATH,
        "sha256": _sha256((root / PUBLISHER_RELATIVE_PATH).read_bytes()),
    }
    source_records = _require_bound_sources(root)
    expected_swift_package_manifest = _require_swift_package_manifest(
        root, source_records=source_records
    )
    expected_node_version = _declared_node_version(root)
    fixture_ids: list[str] = []
    for _, fixture_id, _, report_name, _, _ in MANIFESTS:
        report = _read_json(reports / report_name, f"{fixture_id} agreement report")
        fixture = report.get("fixture")
        if not isinstance(fixture, dict) or fixture.get("fixture_id") != fixture_id:
            raise AgreementError(f"{fixture_id} agreement report identity is invalid")
        if report.get("publisher") != expected_publisher:
            raise AgreementError(f"{fixture_id} publisher provenance is invalid")
        implementation = report.get("implementation")
        if not isinstance(implementation, dict) or implementation.get(
            "swift_package_manifest"
        ) != expected_swift_package_manifest:
            raise AgreementError(
                f"{fixture_id} Swift package manifest provenance is invalid"
            )
        environment = report.get("environment")
        if not isinstance(environment, dict) or environment.get(
            "node"
        ) != expected_node_version:
            raise AgreementError(f"{fixture_id} Node.js runtime provenance is invalid")
        if report.get("test_ids") != list(CANONICAL_TEST_IDS[fixture_id]):
            raise AgreementError(f"{fixture_id} canonical test IDs are invalid")
        fixture_ids.append(fixture_id)
    return tuple(fixture_ids)


def main(arguments: tuple[str, ...] | None = None) -> int:
    selected = tuple(sys.argv[1:]) if arguments is None else arguments
    try:
        if not selected:
            fixture_ids = run()
            label = "three-runtime agreement"
        elif selected == ("--verify-reports",):
            fixture_ids = _verify_reports(_repo_root())
            label = "three-runtime reports"
        else:
            raise AgreementError("unsupported command arguments")
    except AgreementError as error:
        print(f"three-runtime agreement: FAIL ({error})", file=sys.stderr)
        return 1
    print(f"{label}: PASS ({','.join(fixture_ids)})")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
