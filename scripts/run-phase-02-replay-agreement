#!/usr/bin/env python3
"""Generate or verify revision-bound Phase 02 replay agreement evidence."""

from __future__ import annotations

import fcntl
import hashlib
import json
import os
import platform
import re
import shutil
import stat
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any

REPOSITORY_IMPORT_ROOT = Path(__file__).resolve().parents[1]
if str(REPOSITORY_IMPORT_ROOT) not in sys.path:
    sys.path.insert(0, str(REPOSITORY_IMPORT_ROOT))

from tools.verify.compare_replay_reports import (
    PINNED_FIXTURE_SHA256,
    PINNED_REPORT_SCHEMA_SHA256,
    ReplayAgreement,
    ReplayComparisonError,
    canonical_bytes,
    compare_replay_reports,
    verify_fixture_integrity,
)


BOUND_REVISION = "0d371bc1de9a057cbf61b70142729f6cbe620eec"
IMPLEMENTATION_REVISION = f"git:{BOUND_REVISION}"
PUBLISHER_RELATIVE_PATH = "scripts/run-phase-02-replay-agreement"
COMPARATOR_RELATIVE_PATH = "tools/verify/compare_replay_reports.py"
EVIDENCE_RELATIVE_PATH = "evidence/compatibility/replay-agreement.json"
MANIFEST_RELATIVE_PATH = "fixtures/capture/1.0.0/rev-001/manifest.json"
REPORT_SCHEMA_RELATIVE_PATH = "fixtures/replay-report.schema.json"
RRCAP_SCHEMA_RELATIVE_PATH = "docs/contracts/rrcap-manifest.schema.json"
SWIFT_PACKAGE_ROOT_RELATIVE_PATH = "ios/Packages/ReRoomContracts"
SWIFT_PACKAGE_MANIFEST_RELATIVE_PATH = f"{SWIFT_PACKAGE_ROOT_RELATIVE_PATH}/Package.swift"
SWIFT_VERSION_MANIFEST_PATTERN = re.compile(r"Package@swift-[0-9]+(?:\.[0-9]+){0,2}\.swift")
TRANSACTION_DIRECTORY_NAME = ".phase-02-replay-agreement-transaction"
COMMAND_TIMEOUT_SECONDS = 180
BOUND_SOURCE_SCOPES = (
    "fixtures/capture/1.0.0/rev-001",
    REPORT_SCHEMA_RELATIVE_PATH,
    RRCAP_SCHEMA_RELATIVE_PATH,
    SWIFT_PACKAGE_MANIFEST_RELATIVE_PATH,
    f"{SWIFT_PACKAGE_ROOT_RELATIVE_PATH}/Package.resolved",
    f"{SWIFT_PACKAGE_ROOT_RELATIVE_PATH}/Sources/ReRoomContracts",
    f"{SWIFT_PACKAGE_ROOT_RELATIVE_PATH}/Sources/ReRoomCaptureCore",
    f"{SWIFT_PACKAGE_ROOT_RELATIVE_PATH}/Sources/ReRoomReplayRunner",
    "tools/javascript/package.json",
    "tools/javascript/package-lock.json",
    "tools/javascript/src/canonical-json.mjs",
    "tools/javascript/src/loader.mjs",
    "tools/javascript/src/wire-frame.mjs",
    "tools/javascript/src/replay.ts",
    "tools/python/requirements.in",
    "tools/python/requirements.lock",
    "tools/python/reroom_verify/canonical_json.py",
    "tools/python/reroom_verify/loader.py",
    "tools/python/reroom_verify/wire_frame.py",
    "tools/python/reroom_verify/replay.py",
)


class AgreementError(RuntimeError):
    """A stable, sanitized evidence publication failure."""


def _repo_root() -> Path:
    return Path(__file__).resolve().parents[1]


def _sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def _run(
    command: list[str],
    *,
    root: Path,
    label: str,
    timeout: int = COMMAND_TIMEOUT_SECONDS,
) -> subprocess.CompletedProcess[str]:
    try:
        with tempfile.TemporaryDirectory(prefix="reroom-replay-pycache-") as cache:
            environment = dict(os.environ, PYTHONPYCACHEPREFIX=cache)
            completed = subprocess.run(
                command,
                cwd=root,
                env=environment,
                check=False,
                capture_output=True,
                text=True,
                timeout=timeout,
            )
    except (OSError, subprocess.SubprocessError) as error:
        raise AgreementError(f"{label} could not execute") from error
    if completed.returncode != 0:
        diagnostic = completed.stderr.strip().splitlines()
        detail = diagnostic[-1] if diagnostic else f"exit {completed.returncode}"
        if len(detail) > 240:
            detail = detail[-240:]
        raise AgreementError(f"{label} failed: {detail}")
    return completed


def _resolve_executable(value: str | Path, label: str) -> Path:
    text = os.fspath(value)
    candidate = shutil.which(text) if os.sep not in text else text
    if candidate is None:
        raise AgreementError(f"{label} executable is unavailable")
    path = Path(candidate).expanduser().absolute()
    try:
        mode = path.lstat().st_mode
    except OSError as error:
        raise AgreementError(f"{label} executable is unavailable") from error
    if path.is_symlink():
        resolved = path.resolve(strict=True)
        mode = resolved.lstat().st_mode
        path = resolved
    if not stat.S_ISREG(mode) or not os.access(path, os.X_OK):
        raise AgreementError(f"{label} executable is unavailable")
    return path


def _version(command: list[str], root: Path, label: str) -> str:
    completed = _run(command, root=root, label=label, timeout=20)
    text = (completed.stdout or completed.stderr).strip()
    if not text:
        raise AgreementError(f"{label} version is unavailable")
    return " ".join(text.split())


def _is_python_cache(relative: str, *, directory: bool) -> bool:
    parts = Path(relative).parts
    return "__pycache__" in parts and (directory or relative.endswith(".pyc"))


def _require_bound_sources(root: Path) -> list[dict[str, str]]:
    _run(
        ["git", "cat-file", "-e", f"{BOUND_REVISION}^{{commit}}"],
        root=root,
        label="bound implementation revision",
        timeout=10,
    )
    listing = _run(
        ["git", "ls-tree", "-r", "-z", BOUND_REVISION, "--", *BOUND_SOURCE_SCOPES],
        root=root,
        label="bound implementation source listing",
        timeout=20,
    )
    expected: dict[str, str] = {}
    for entry in listing.stdout.split("\0"):
        if not entry:
            continue
        try:
            metadata, relative = entry.split("\t", 1)
            mode, kind, _ = metadata.split(" ", 2)
        except ValueError as error:
            raise AgreementError("bound implementation source listing is malformed") from error
        if kind != "blob" or mode not in {"100644", "100755"}:
            raise AgreementError("a bound implementation source is not a regular file")
        expected[relative] = mode
    if not expected:
        raise AgreementError("bound implementation source set is empty")

    directory_scopes = tuple(
        scope.rstrip("/")
        for scope in BOUND_SOURCE_SCOPES
        if any(relative.startswith(f"{scope.rstrip('/')}/") for relative in expected)
    )
    expected_directories = set(directory_scopes)
    for relative in expected:
        for scope in directory_scopes:
            if not relative.startswith(f"{scope}/"):
                continue
            parent = Path(relative).parent
            while parent.as_posix().startswith(scope):
                expected_directories.add(parent.as_posix())
                if parent.as_posix() == scope:
                    break
                parent = parent.parent

    for scope in directory_scopes:
        scope_path = root / scope
        try:
            scope_mode = scope_path.lstat().st_mode
        except OSError as error:
            raise AgreementError("a bound implementation source is unavailable") from error
        if not stat.S_ISDIR(scope_mode) or scope_path.is_symlink():
            raise AgreementError("a bound implementation source directory is not regular")
        for current, directories, names in os.walk(scope_path, topdown=True, followlinks=False):
            directories.sort()
            names.sort()
            current_path = Path(current)
            for name in directories:
                path = current_path / name
                relative = path.relative_to(root).as_posix()
                mode = path.lstat().st_mode
                if path.is_symlink() or not stat.S_ISDIR(mode):
                    raise AgreementError("a bound implementation source is not a regular file")
                if relative not in expected_directories and not _is_python_cache(relative, directory=True):
                    raise AgreementError(
                        "an implementation source exists outside the bound implementation revision"
                    )
            for name in names:
                path = current_path / name
                relative = path.relative_to(root).as_posix()
                mode = path.lstat().st_mode
                if path.is_symlink() or not stat.S_ISREG(mode):
                    raise AgreementError("a bound implementation source is not a regular file")
                if relative not in expected and not _is_python_cache(relative, directory=False):
                    raise AgreementError(
                        "an implementation source exists outside the bound implementation revision"
                    )

    records: list[dict[str, str]] = []
    executable_bits = stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH
    for relative, expected_mode in sorted(expected.items()):
        path = root / relative
        try:
            mode = path.lstat().st_mode
            data = path.read_bytes()
        except OSError as error:
            raise AgreementError("a bound implementation source is unavailable") from error
        if path.is_symlink() or not stat.S_ISREG(mode):
            raise AgreementError("a bound implementation source is not a regular file")
        if bool(mode & executable_bits) != (expected_mode == "100755"):
            raise AgreementError("a bound implementation source mode differs from the bound revision")
        records.append({"relative_path": relative, "sha256": _sha256(data)})
    comparison = subprocess.run(
        ["git", "diff", "--quiet", BOUND_REVISION, "--", *BOUND_SOURCE_SCOPES],
        cwd=root,
        check=False,
        capture_output=True,
        text=True,
        timeout=20,
    )
    if comparison.returncode != 0:
        raise AgreementError("bound implementation sources differ from their recorded revision")
    return records


def _require_auxiliary_source(root: Path, relative: str, executable: bool) -> dict[str, str]:
    path = root / relative
    try:
        mode = path.lstat().st_mode
        data = path.read_bytes()
    except OSError as error:
        raise AgreementError("agreement tooling source is unavailable") from error
    if path.is_symlink() or not stat.S_ISREG(mode):
        raise AgreementError("agreement tooling source is not regular")
    if bool(mode & (stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)) != executable:
        raise AgreementError("agreement tooling source mode is invalid")
    tracked = subprocess.run(
        ["git", "ls-files", "--error-unmatch", "--", relative],
        cwd=root,
        check=False,
        capture_output=True,
        text=True,
        timeout=10,
    )
    if tracked.returncode != 0:
        raise AgreementError("agreement tooling source is untracked or ignored")
    return {"relative_path": relative, "sha256": _sha256(data)}


def _source_tree_digest(records: list[dict[str, str]]) -> str:
    scope = "".join(
        f"{record['relative_path']}\0{record['sha256']}\n" for record in records
    ).encode("utf-8")
    return _sha256(scope)


def _require_swift_manifest(root: Path, records: list[dict[str, str]]) -> dict[str, str]:
    package_root = root / SWIFT_PACKAGE_ROOT_RELATIVE_PATH
    try:
        entries = tuple(package_root.iterdir())
    except OSError as error:
        raise AgreementError("Swift package root is unavailable") from error
    for entry in entries:
        if SWIFT_VERSION_MANIFEST_PATTERN.fullmatch(entry.name):
            raise AgreementError("a version-specific Swift package manifest can override Package.swift")
    selected = [
        record
        for record in records
        if record["relative_path"] == SWIFT_PACKAGE_MANIFEST_RELATIVE_PATH
    ]
    if len(selected) != 1:
        raise AgreementError("the exact selected Swift package manifest is unavailable")
    return selected[0]


def _require_exclusive_output(path: Path) -> None:
    if path.exists() or path.is_symlink():
        raise AgreementError("runtime output root must not exist")
    try:
        mode = path.parent.lstat().st_mode
    except OSError as error:
        raise AgreementError("runtime output parent is unavailable") from error
    if path.parent.is_symlink() or not stat.S_ISDIR(mode):
        raise AgreementError("runtime output parent is invalid")


def _build_swift_runner(root: Path) -> Path:
    _run(
        [
            "swift", "build", "--package-path", SWIFT_PACKAGE_ROOT_RELATIVE_PATH,
            "--product", "ReRoomReplayRunner",
        ],
        root=root,
        label="Swift replay target build",
    )
    binary_root = _run(
        ["swift", "build", "--package-path", SWIFT_PACKAGE_ROOT_RELATIVE_PATH, "--show-bin-path"],
        root=root,
        label="Swift replay binary path",
    ).stdout.strip()
    if not binary_root:
        raise AgreementError("Swift replay target or binary is unavailable")
    return _resolve_executable(Path(binary_root) / "ReRoomReplayRunner", "Swift replay runner")


def _runtime_environment(root: Path, node: Path, python: Path) -> dict[str, str]:
    node_version = _version([str(node), "--version"], root, "Node.js")
    if node_version != "v22.22.3":
        raise AgreementError("Node.js runtime does not match exact v22.22.3")
    python_version = _version([str(python), "--version"], root, "Python")
    if python_version != "Python 3.13.12":
        raise AgreementError("Python runtime does not match exact 3.13.12")
    return {
        "operating_system": f"{platform.system()} {platform.release()}",
        "architecture": platform.machine(),
        "swift": _version(["swift", "--version"], root, "Swift"),
        "node": node_version,
        "python": python_version,
    }


def _invoke_runtimes(
    root: Path, temporary: Path, swift_runner: Path, node: Path, python: Path
) -> dict[str, Path]:
    outputs = {runtime: temporary / runtime for runtime in ("swift", "node", "python")}
    for output in outputs.values():
        _require_exclusive_output(output)
    common = [
        "--manifest", str(root / MANIFEST_RELATIVE_PATH),
        "--repo-root", str(root),
        "--implementation-revision", IMPLEMENTATION_REVISION,
    ]
    commands = {
        "swift": [str(swift_runner)],
        "node": [str(node), str(root / "tools/javascript/src/replay.ts")],
        "python": [str(python), "-m", "tools.python.reroom_verify.replay"],
    }
    for runtime in ("swift", "node", "python"):
        _run(
            [*commands[runtime], *common, "--output-root", str(outputs[runtime])],
            root=root,
            label=f"{runtime} replay runner",
        )
    return outputs


def _evidence_object(
    *,
    agreement: ReplayAgreement,
    environment: dict[str, str],
    source_records: list[dict[str, str]],
    swift_manifest: dict[str, str],
    publisher: dict[str, str],
    comparator: dict[str, str],
    root: Path,
) -> dict[str, Any]:
    fixture_path = root / MANIFEST_RELATIVE_PATH
    report_schema = root / REPORT_SCHEMA_RELATIVE_PATH
    rrcap_schema = root / RRCAP_SCHEMA_RELATIVE_PATH
    evidence: dict[str, Any] = {
        "schema_version": "1.0.0",
        "evidence_id": "evidence_phase_02_replay_agreement_rev_001",
        "classification": "MEASURED",
        "requirement_ids": ["FR-B0-001", "NFR-REPLAY-001", "FR-CAPTURE-001"],
        "test_ids": ["TST-CAPTURE-001", "TST-REPLAY-001", "TST-REPLAY-002", "TST-B0-001"],
        "fixture": {
            "fixture_id": "FX-CAPTURE-001",
            "fixture_revision": "rev-001",
            "relative_path": MANIFEST_RELATIVE_PATH,
            "manifest_sha256": _sha256(fixture_path.read_bytes()),
            "replay_report_schema_sha256": _sha256(report_schema.read_bytes()),
            "rrcap_schema_sha256": _sha256(rrcap_schema.read_bytes()),
        },
        "implementation": {
            "revision": IMPLEMENTATION_REVISION,
            "source_tree_sha256": _source_tree_digest(source_records),
            "source_tree_digest_algorithm": "SHA-256 over sorted relative_path NUL sha256 LF records",
            "source_file_count": len(source_records),
            "source_scopes": list(BOUND_SOURCE_SCOPES),
            "swift_package_manifest": swift_manifest,
        },
        "runtimes": {
            "swift": {
                "runtime": "swift",
                "build_id": "ReRoomReplayCore-1.0.0",
                "evaluator": "ReRoomReplayCore-1.0.0",
                "toolchain": environment["swift"],
            },
            "node": {
                "runtime": "node-v22.22.3",
                "build_id": "ReRoomReplayNode-1.0.0",
                "evaluator": "ReRoomReplayNode-1.0.0",
                "toolchain": environment["node"],
            },
            "python": {
                "runtime": "python-3.13.12",
                "build_id": "ReRoomReplayPython-1.0.0",
                "evaluator": "ReRoomReplayPython-1.0.0",
                "toolchain": environment["python"],
            },
        },
        "raw_outputs": {
            output.runtime: {
                "report_count": output.report_count,
                "byte_length": output.byte_length,
                "directory_sha256": output.directory_sha256,
            }
            for output in agreement.outputs
        },
        "cases": [
            {
                "case_id": case.case_id,
                "verdict": case.verdict,
                "rejection_class": case.rejection_class,
                "artifact_sha256": case.artifact_sha256,
            }
            for case in agreement.cases
        ],
        "agreement": {
            "verdict": "pass",
            "runtime_count": len(agreement.runtimes),
            "case_count": len(agreement.cases),
            "missing_cases": agreement.missing_cases,
            "extra_cases": agreement.extra_cases,
            "semantic_disagreements": agreement.semantic_disagreements,
            "runtime_identity_disagreements": 0,
            "report_digest_disagreements": 0,
            "fixture_integrity_disagreements": 0,
            "metric_calculation": (
                "validate each closed report against the immutable fixture and self-digest; "
                "then compare case ID, verdict, rejection, archive/digests/metrics artifact bytes"
            ),
        },
        "evaluator": comparator,
        "publisher": publisher,
        "environment": environment,
        "reproduction": {
            "command": PUBLISHER_RELATIVE_PATH,
            "success_condition": "16 complete sorted cases and zero three-runtime semantic disagreements",
            "publication": "recoverable prepared/committed durable single-generation transaction",
        },
        "limitations": [
            "This host-runtime result is not physical-device, signing, ARKit, compositor, or thermal evidence.",
            "The NFR-REPLAY-001 three-minute goal remains a hypothesis until separately measured with raw timing evidence.",
        ],
    }
    evidence["evidence_sha256"] = _sha256(canonical_bytes(evidence))
    return evidence


def _generate_evidence(root: Path | None = None) -> bytes:
    root = (root or _repo_root()).resolve()
    publisher = _require_auxiliary_source(root, PUBLISHER_RELATIVE_PATH, True)
    comparator = _require_auxiliary_source(root, COMPARATOR_RELATIVE_PATH, False)
    initial_sources = _require_bound_sources(root)
    swift_manifest = _require_swift_manifest(root, initial_sources)
    fixture = verify_fixture_integrity(root / MANIFEST_RELATIVE_PATH, repo_root=root)
    if fixture.manifest_sha256 != PINNED_FIXTURE_SHA256:
        raise AgreementError("capture fixture binding is invalid")
    node = _resolve_executable("node", "Node.js")
    python = _resolve_executable(root / ".venv/bin/python", "locked Python")
    environment = _runtime_environment(root, node, python)
    swift_runner = _build_swift_runner(root)
    with tempfile.TemporaryDirectory(prefix="reroom-phase-02-replay-") as temporary_name:
        outputs = _invoke_runtimes(
            root, Path(temporary_name), swift_runner, node, python
        )
        try:
            agreement = compare_replay_reports(
                root / MANIFEST_RELATIVE_PATH,
                outputs,
                repo_root=root,
                implementation_revision=IMPLEMENTATION_REVISION,
            )
        except ReplayComparisonError as error:
            raise AgreementError(f"three-runtime replay comparison failed: {error}") from error
    if _require_bound_sources(root) != initial_sources:
        raise AgreementError("bound implementation sources changed during execution")
    if _require_auxiliary_source(root, PUBLISHER_RELATIVE_PATH, True) != publisher:
        raise AgreementError("publisher changed during execution")
    if _require_auxiliary_source(root, COMPARATOR_RELATIVE_PATH, False) != comparator:
        raise AgreementError("evaluator changed during execution")
    if _require_swift_manifest(root, initial_sources) != swift_manifest:
        raise AgreementError("Swift package manifest changed during execution")
    verify_fixture_integrity(root / MANIFEST_RELATIVE_PATH, repo_root=root)
    evidence = _evidence_object(
        agreement=agreement,
        environment=environment,
        source_records=initial_sources,
        swift_manifest=swift_manifest,
        publisher=publisher,
        comparator=comparator,
        root=root,
    )
    return json.dumps(evidence, indent=2, sort_keys=True).encode("utf-8") + b"\n"


def _fsync_directory(directory: Path) -> None:
    descriptor = os.open(directory, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def _write_durable(path: Path, data: bytes) -> None:
    with path.open("xb") as handle:
        handle.write(data)
        handle.flush()
        os.fsync(handle.fileno())


def _replace_evidence_path(source: Path, target: Path) -> None:
    os.replace(source, target)


def _read_marker(transaction: Path) -> dict[str, Any]:
    marker_path = transaction / "transaction.json"
    try:
        marker = json.loads(marker_path.read_bytes())
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise AgreementError("evidence transaction marker is invalid") from error
    required = {
        "schema_version", "state", "target", "existed", "old_sha256", "new_sha256"
    }
    if (
        not isinstance(marker, dict)
        or set(marker) != required
        or marker["schema_version"] != "1.0.0"
        or marker["state"] not in {"prepared", "committed"}
        or not isinstance(marker["target"], str)
        or Path(marker["target"]).name != marker["target"]
        or not isinstance(marker["existed"], bool)
        or not isinstance(marker["new_sha256"], str)
        or re.fullmatch(r"[0-9a-f]{64}", marker["new_sha256"]) is None
        or (marker["existed"] and re.fullmatch(r"[0-9a-f]{64}", marker["old_sha256"] or "") is None)
        or (not marker["existed"] and marker["old_sha256"] is not None)
    ):
        raise AgreementError("evidence transaction marker is invalid")
    return marker


def _cleanup_transaction(transaction: Path) -> None:
    if not transaction.exists():
        return
    allowed = {"transaction.json", "transaction.tmp", "new", "old", "restore"}
    for path in transaction.iterdir():
        if path.name not in allowed or path.is_symlink() or not stat.S_ISREG(path.lstat().st_mode):
            raise AgreementError("evidence transaction contains an unexpected path")
    for name in ("transaction.tmp", "new", "old", "restore", "transaction.json"):
        path = transaction / name
        if path.exists():
            path.unlink()
    _fsync_directory(transaction)
    transaction.rmdir()
    _fsync_directory(transaction.parent)


def _recover_evidence_transaction_unlocked(target: Path) -> str:
    transaction = target.parent / TRANSACTION_DIRECTORY_NAME
    if not transaction.exists():
        return "none"
    try:
        mode = transaction.lstat().st_mode
    except OSError as error:
        raise AgreementError("evidence transaction recovery is unavailable") from error
    if transaction.is_symlink() or not stat.S_ISDIR(mode):
        raise AgreementError("evidence transaction path is invalid")
    marker = _read_marker(transaction)
    if marker["target"] != target.name:
        raise AgreementError("evidence transaction target is invalid")
    if marker["state"] == "committed":
        try:
            data = target.read_bytes()
            target_mode = target.lstat().st_mode
        except OSError as error:
            raise AgreementError("committed evidence is unavailable") from error
        if target.is_symlink() or not stat.S_ISREG(target_mode) or _sha256(data) != marker["new_sha256"]:
            raise AgreementError("committed evidence is invalid")
    elif marker["existed"]:
        old = transaction / "old"
        try:
            old_data = old.read_bytes()
            old_mode = old.lstat().st_mode
        except OSError as error:
            raise AgreementError("evidence transaction backup is unavailable") from error
        if old.is_symlink() or not stat.S_ISREG(old_mode) or _sha256(old_data) != marker["old_sha256"]:
            raise AgreementError("evidence transaction backup is invalid")
        restore = transaction / "restore"
        if restore.exists():
            restore.unlink()
        _write_durable(restore, old_data)
        os.replace(restore, target)
        _fsync_directory(target.parent)
    elif target.exists():
        if target.is_symlink() or not stat.S_ISREG(target.lstat().st_mode):
            raise AgreementError("prepared evidence target is invalid")
        target.unlink()
        _fsync_directory(target.parent)
    state = marker["state"]
    _cleanup_transaction(transaction)
    return state


def _recover_evidence_transaction(target: Path) -> None:
    target.parent.mkdir(parents=True, exist_ok=True)
    descriptor = os.open(target.parent, os.O_RDONLY)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        _recover_evidence_transaction_unlocked(target)
    finally:
        fcntl.flock(descriptor, fcntl.LOCK_UN)
        os.close(descriptor)


def _atomic_write_evidence(target: Path, data: bytes) -> None:
    target.parent.mkdir(parents=True, exist_ok=True)
    descriptor = os.open(target.parent, os.O_RDONLY)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        _recover_evidence_transaction_unlocked(target)
        transaction = target.parent / TRANSACTION_DIRECTORY_NAME
        try:
            transaction.mkdir(mode=0o700)
        except OSError as error:
            raise AgreementError("evidence transaction cannot be prepared") from error
        existed = target.exists()
        if existed:
            if target.is_symlink() or not stat.S_ISREG(target.lstat().st_mode):
                raise AgreementError("existing evidence target is invalid")
            old_data = target.read_bytes()
            _write_durable(transaction / "old", old_data)
        else:
            old_data = None
        _write_durable(transaction / "new", data)
        marker = {
            "schema_version": "1.0.0",
            "state": "prepared",
            "target": target.name,
            "existed": existed,
            "old_sha256": _sha256(old_data) if old_data is not None else None,
            "new_sha256": _sha256(data),
        }
        marker_bytes = json.dumps(marker, indent=2, sort_keys=True).encode("utf-8") + b"\n"
        _write_durable(transaction / "transaction.tmp", marker_bytes)
        os.replace(transaction / "transaction.tmp", transaction / "transaction.json")
        _fsync_directory(transaction)
        _fsync_directory(target.parent)
        try:
            _replace_evidence_path(transaction / "new", target)
            _fsync_directory(target.parent)
            marker["state"] = "committed"
            marker_bytes = json.dumps(marker, indent=2, sort_keys=True).encode("utf-8") + b"\n"
            _write_durable(transaction / "transaction.tmp", marker_bytes)
            os.replace(transaction / "transaction.tmp", transaction / "transaction.json")
            _fsync_directory(transaction)
            _fsync_directory(target.parent)
        except Exception as error:
            try:
                recovered = _recover_evidence_transaction_unlocked(target)
            except AgreementError as recovery_error:
                raise AgreementError("evidence publication failed and recovery is incomplete") from recovery_error
            if recovered == "prepared":
                raise AgreementError("evidence publication failed and previous evidence was restored") from error
            raise AgreementError("evidence publication failed after the new evidence committed") from error
        _cleanup_transaction(transaction)
    finally:
        fcntl.flock(descriptor, fcntl.LOCK_UN)
        os.close(descriptor)


def run(*, evidence_path: Path | None = None) -> Path:
    root = _repo_root()
    target = evidence_path or root / EVIDENCE_RELATIVE_PATH
    data = _generate_evidence(root)
    _atomic_write_evidence(target, data)
    return target


def verify_evidence(path: Path | None = None) -> None:
    root = _repo_root()
    target = path or root / EVIDENCE_RELATIVE_PATH
    _recover_evidence_transaction(target)
    try:
        raw = target.read_bytes()
        evidence = json.loads(raw)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise AgreementError("replay agreement evidence is malformed") from error
    if not isinstance(evidence, dict):
        raise AgreementError("replay agreement evidence root is invalid")
    recorded_digest = evidence.pop("evidence_sha256", None)
    if recorded_digest != _sha256(canonical_bytes(evidence)):
        raise AgreementError("replay agreement evidence self-digest is invalid")
    if evidence.get("publisher") != _require_auxiliary_source(root, PUBLISHER_RELATIVE_PATH, True):
        raise AgreementError("replay agreement publisher provenance is invalid")
    if evidence.get("evaluator") != _require_auxiliary_source(root, COMPARATOR_RELATIVE_PATH, False):
        raise AgreementError("replay agreement evaluator provenance is invalid")
    sources = _require_bound_sources(root)
    implementation = evidence.get("implementation")
    if (
        not isinstance(implementation, dict)
        or implementation.get("revision") != IMPLEMENTATION_REVISION
        or implementation.get("source_tree_sha256") != _source_tree_digest(sources)
        or implementation.get("swift_package_manifest") != _require_swift_manifest(root, sources)
    ):
        raise AgreementError("replay agreement implementation provenance is invalid")
    verify_fixture_integrity(root / MANIFEST_RELATIVE_PATH, repo_root=root)
    fixture = evidence.get("fixture")
    if (
        not isinstance(fixture, dict)
        or fixture.get("manifest_sha256") != PINNED_FIXTURE_SHA256
        or fixture.get("replay_report_schema_sha256") != PINNED_REPORT_SCHEMA_SHA256
    ):
        raise AgreementError("replay agreement fixture provenance is invalid")
    agreement = evidence.get("agreement")
    cases = evidence.get("cases")
    if (
        not isinstance(agreement, dict)
        or agreement.get("verdict") != "pass"
        or agreement.get("runtime_count") != 3
        or agreement.get("case_count") != 16
        or any(
            agreement.get(field) != 0
            for field in (
                "missing_cases", "extra_cases", "semantic_disagreements",
                "runtime_identity_disagreements", "report_digest_disagreements",
                "fixture_integrity_disagreements",
            )
        )
        or not isinstance(cases, list)
        or len(cases) != 16
        or [case.get("case_id") for case in cases] != sorted(case.get("case_id") for case in cases)
    ):
        raise AgreementError("replay agreement metrics are invalid")


def main(arguments: tuple[str, ...] | None = None) -> int:
    selected = tuple(sys.argv[1:] if arguments is None else arguments)
    try:
        if not selected:
            target = run()
            label = f"published {target.relative_to(_repo_root())}"
        elif selected == ("--verify-evidence",):
            verify_evidence()
            label = "verified replay agreement evidence"
        else:
            raise AgreementError("unsupported command arguments")
    except (AgreementError, ReplayComparisonError) as error:
        print(f"phase-02 replay agreement: FAIL ({error})", file=sys.stderr)
        return 1
    print(f"phase-02 replay agreement: PASS ({label})")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
