from datetime import UTC, datetime
from pathlib import Path
from typing import Any, Callable, Sequence

REPOSITORY_IMPORT_ROOT = Path(__file__).resolve().parents[1]
if str(REPOSITORY_IMPORT_ROOT) not in sys.path:
    sys.path.insert(0, str(REPOSITORY_IMPORT_ROOT))

from tools.verify.compare_transaction_traces import (  # noqa: E402
    PINNED_CASES_SHA256,
    PINNED_MANIFEST_SHA256,
    PINNED_RESULT_SCHEMA_SHA256,
    PINNED_TRACES_SHA256,
    RUNTIME_IDENTITIES,
    TransactionComparisonError,
    canonical_bytes,
    compare_transaction_traces,
    verify_transaction_fixture,
)


BOUND_REVISION = "10de1b6bde8e447143f61cb2833618b86486a6a9"
IMPLEMENTATION_REVISION = f"git:{BOUND_REVISION}"
EXACT_NODE_VERSION = "v22.22.3"
MANIFEST_RELATIVE_PATH = "fixtures/transactions/1.0.0/rev-001/manifest.json"
EVIDENCE_RELATIVE_PATH = "evidence/transactions/phase-03/automated-preflight.json"
COMPARATOR_RELATIVE_PATH = "tools/verify/compare_transaction_traces.py"
RESULT_SCHEMA_RELATIVE_PATH = "tools/verify/transaction-trace-result.schema.json"
ORCHESTRATOR_RELATIVE_PATH = "scripts/verify-phase-03-transactions"
SWIFT_PACKAGE = "apps/ios/Packages/ReRoomContracts"
XCODE_PROJECT = "apps/ios/ReRoomDeviceProof/ReRoomDeviceProof.xcodeproj"
XCODE_DESTINATION = "platform=iOS Simulator,name=iPhone 17"
COMMAND_TIMEOUT_SECONDS = 900
PRODUCER_SOURCE_SCOPES = (
    "packages/contracts/src/canonical-json.mjs",
    "packages/contracts/src/transaction.ts",
    "tools/python/reroom_verify/transaction.py",
    "apps/ios/Packages/ReRoomContracts/Sources/ReRoomTransactionCore",
    "apps/ios/Packages/ReRoomContracts/Sources/ReRoomTransactionTraceExporter",
)
EXPECTED_QUICK_CHECKS = (
    "fixture_integrity",
    "swift_transaction_tests",
    "typescript_transaction_tests",
    "python_transaction_tests",
    "producer_two_run_identity",
    "three_runtime_agreement",
)
EXPECTED_FULL_CHECKS = EXPECTED_QUICK_CHECKS + (
    "room_edit_model_tests",
    "room_edit_ui_tests",
    "debug_build",
    "release_build",
    "release_surface",
    "tracked_secret_scan",
    "whitespace_check",
)
PENDING_GATES = (
    "GATE-009",
    "GATE-010",
    "GATE-011",
    "physical_device",
    "reconnect_replication_campaign",
    "proxy_license_qualification",
    "full_p0",
)
HEX_DIGEST = re.compile(r"[0-9a-f]{64}\Z")
UTC_TIMESTAMP = re.compile(r"20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z\Z")
FORBIDDEN_VALUE = re.compile(
    r"(?:/Users/|/home/|file://|[A-Za-z]:\\\\|api[_-]?key\s*[:=]|bearer\s+[A-Za-z0-9._-]{8,}|"
    r"sk-[A-Za-z0-9_-]{16,}|-----BEGIN [A-Z ]*PRIVATE KEY-----)",
    re.IGNORECASE,
)
FORBIDDEN_KEY_PARTS = ("raw_room", "user_text", "device_id", "user_id", "credential", "human_observation")
SECRET_PATTERNS = (
    re.compile(rb"sk-[A-Za-z0-9_-]{20,}"),
    re.compile(rb"AKIA[0-9A-Z]{16}"),
    re.compile(rb"gh[ps]_[A-Za-z0-9]{30,}"),
    re.compile(rb"xox[baprs]-[A-Za-z0-9-]{20,}"),
    re.compile(rb"-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----"),
)


class EvidenceError(RuntimeError):
    """A stable verifier or evidence publication failure."""


def _sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def _run(command: list[str], *, root: Path, label: str, timeout: int = COMMAND_TIMEOUT_SECONDS) -> bytes:
    try:
        completed = subprocess.run(
            command,
            cwd=root,
            check=False,
            capture_output=True,
            timeout=timeout,
        )
    except (OSError, subprocess.SubprocessError) as error:
        raise EvidenceError(f"check:{label}:execution") from error
    if completed.returncode != 0:
        raise EvidenceError(f"check:{label}:failed")
    return completed.stdout + completed.stderr


def _executable(name: str) -> str:
    candidate = shutil.which(name)
    if candidate is None:
        raise EvidenceError(f"runtime:{name}:missing")
    path = Path(candidate).resolve(strict=True)
    if not stat.S_ISREG(path.stat().st_mode) or not os.access(path, os.X_OK):
        raise EvidenceError(f"runtime:{name}:invalid")
    return str(path)


def _require_runtime_versions(root: Path) -> dict[str, str]:
    node = _executable("node")
    python = _executable("python3")
    swift = _executable("swift")
    node_version = _run([node, "--version"], root=root, label="node_version", timeout=20).decode().strip()
    if node_version != EXACT_NODE_VERSION:
        raise EvidenceError("runtime:node:version")
    python_version = _run([python, "--version"], root=root, label="python_version", timeout=20).decode().strip()
    if python_version != "Python 3.13.12":
        raise EvidenceError("runtime:python:version")
    swift_version = _run([swift, "--version"], root=root, label="swift_version", timeout=20).decode().splitlines()[0].strip()
    return {"node": node, "python": python, "swift": swift, "swift_version": swift_version}


def _require_bound_producer_sources(root: Path) -> None:
    _run(["git", "cat-file", "-e", f"{BOUND_REVISION}^{{commit}}"], root=root, label="bound_revision", timeout=20)
    try:
        comparison = subprocess.run(
            ["git", "diff", "--quiet", BOUND_REVISION, "--", *PRODUCER_SOURCE_SCOPES],
            cwd=root,
            check=False,
            capture_output=True,
            timeout=30,
        )
    except (OSError, subprocess.SubprocessError) as error:
        raise EvidenceError("source_binding:execution") from error
    if comparison.returncode != 0:
        raise EvidenceError("source_binding:producer_drift")


def _check_record(check_id: str, output: bytes) -> dict[str, str]:
    return {"check_id": check_id, "command_id": check_id, "status": "PASS", "outcome_sha256": _sha256(output or b"PASS")}


def _run_producer(command: list[str], common: list[str], root: Path, runtime: str) -> bytes:
    with tempfile.TemporaryDirectory(prefix=f"reroom-phase-03-{runtime}-") as directory:
        temporary = Path(directory)
        if temporary.stat().st_mode & 0o077:
            raise EvidenceError(f"producer:{runtime}:temporary_permissions")
        output = temporary / "result.json"
        _run([*command, *common, "--output", str(output)], root=root, label=f"producer_{runtime}")
        try:
            data = output.read_bytes()
        except OSError as error:
            raise EvidenceError(f"producer:{runtime}:result") from error
        if not data:
            raise EvidenceError(f"producer:{runtime}:empty")
        return data


def _two_run_agreement(root: Path, runtimes: dict[str, str]) -> tuple[dict[str, dict[str, Any]], bytes]:
    build = _run(
        [runtimes["swift"], "build", "--package-path", SWIFT_PACKAGE, "--product", "ReRoomTransactionTraceExporter"],
        root=root,
        label="swift_exporter_build",
    )
    binary_root = _run(
        [runtimes["swift"], "build", "--package-path", SWIFT_PACKAGE, "--show-bin-path"],
        root=root,
        label="swift_exporter_path",
    ).decode().strip()
    exporter = Path(binary_root) / "ReRoomTransactionTraceExporter"
    commands = {
        "swift": [str(exporter)],
        "typescript": [runtimes["node"], "packages/contracts/src/transaction.ts"],
        "python": [runtimes["python"], "-m", "tools.python.reroom_verify.transaction"],
    }
    common = [
        "--manifest", str(root / MANIFEST_RELATIVE_PATH),
        "--repo-root", str(root),
        "--implementation-revision", IMPLEMENTATION_REVISION,
    ]
    results: dict[str, bytes] = {}
    runtime_runs: dict[str, dict[str, Any]] = {}
    for runtime, command in commands.items():
        first = _run_producer(command, common, root, runtime)
        second = _run_producer(command, common, root, runtime)
        if first != second:
            raise EvidenceError(f"producer:{runtime}:byte_identity")
        results[runtime] = first
        decoded = json.loads(first)
        runtime_runs[runtime] = {
            "byte_identical": True,
            "run_count": 2,
            "result_sha256": _sha256(first),
            "source_tree_sha256": decoded["implementation"]["source_tree_sha256"],
        }
    with tempfile.TemporaryDirectory(prefix="reroom-phase-03-compare-") as directory:
        compare_root = Path(directory)
        paths: dict[str, Path] = {}
        for runtime, data in results.items():
            path = compare_root / f"{runtime}.json"
            path.write_bytes(data)
            paths[runtime] = path
        try:
            comparison = compare_transaction_traces(
                root / MANIFEST_RELATIVE_PATH,
                paths,
                repo_root=root,
                implementation_revision=IMPLEMENTATION_REVISION,
            )
        except TransactionComparisonError as error:
            raise EvidenceError(f"comparison:{error}") from error
    summary = canonical_bytes({"case_count": comparison.case_count, "runtime_runs": runtime_runs})
    return runtime_runs, build + summary


def _scan_tracked_secrets(root: Path) -> bytes:
    listing = _run(["git", "ls-files", "-z"], root=root, label="tracked_file_listing", timeout=60)
    checked = 0
    for raw_relative in listing.split(b"\0"):
        if not raw_relative:
            continue
        try:
            relative = raw_relative.decode("utf-8")
        except UnicodeDecodeError as error:
            raise EvidenceError("secret_scan:path_encoding") from error
        path = root / relative
        try:
            if path.is_symlink() or not path.is_file():
                raise EvidenceError("secret_scan:non_regular")
            data = path.read_bytes()
        except OSError as error:
            raise EvidenceError("secret_scan:unreadable") from error
        if any(pattern.search(data) for pattern in SECRET_PATTERNS):
            raise EvidenceError("secret_scan:credential_pattern")
        checked += 1
    return canonical_bytes({"tracked_files_checked": checked})


def _working_tree_counts(root: Path) -> dict[str, int]:
    status = _run(["git", "status", "--porcelain=v1", "-z"], root=root, label="working_tree_status", timeout=30)
    tracked_modified = 0
    untracked = 0
    for record in status.split(b"\0"):
        if not record:
            continue
        if record.startswith(b"??"):
            untracked += 1
        else:
            tracked_modified += 1
    return {"tracked_modified": tracked_modified, "untracked": untracked}


def _reboot_booted_ui_simulator(root: Path) -> bytes:
    """Give XCUITest a fresh runner host after the preceding model test session."""

    xcrun = _executable("xcrun")
    listing = _run([xcrun, "simctl", "list", "devices", "available", "-j"], root=root, label="ui_simulator_listing", timeout=30)
    try:
        document = json.loads(listing)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise EvidenceError("ui_simulator:listing") from error
    devices = document.get("devices") if isinstance(document, dict) else None
    if not isinstance(devices, dict):
        raise EvidenceError("ui_simulator:listing")
    candidates = [
        item
        for values in devices.values()
        if isinstance(values, list)
        for item in values
        if isinstance(item, dict) and item.get("name") == "iPhone 17" and item.get("isAvailable", True) is True
    ]
    if len(candidates) != 1 or not isinstance(candidates[0].get("udid"), str) or candidates[0].get("state") not in {"Booted", "Shutdown"}:
        raise EvidenceError("ui_simulator:unique_target")
    identifier = candidates[0]["udid"]
    shutdown = b""
    if candidates[0]["state"] == "Booted":
        shutdown = _run([xcrun, "simctl", "shutdown", identifier], root=root, label="ui_simulator_shutdown", timeout=60)
    boot = _run([xcrun, "simctl", "boot", identifier], root=root, label="ui_simulator_boot", timeout=60)
    ready = _run([xcrun, "simctl", "bootstatus", identifier, "-b"], root=root, label="ui_simulator_ready", timeout=180)
    return shutdown + boot + ready


def _walk_strings(value: Any, *, key: str = "root") -> None:
    if isinstance(value, dict):
        for child_key, child in value.items():
            lowered = child_key.lower()
            if child_key not in {
                "raw_room_data_included", "user_content_included", "machine_paths_included",
                "identifiers_included", "credentials_included", "human_observations_included",
            } and any(part in lowered for part in FORBIDDEN_KEY_PARTS):
                raise EvidenceError("evidence:private_field")
            _walk_strings(child, key=child_key)
    elif isinstance(value, list):
        for child in value:
            _walk_strings(child, key=key)
    elif isinstance(value, str) and FORBIDDEN_VALUE.search(value):
        raise EvidenceError("evidence:private_value")


def _evidence_template(
    *,
    recorded_at_utc: str,
    checks: list[dict[str, str]],
    runtime_runs: dict[str, dict[str, Any]],
    source_bindings: dict[str, str],
    working_tree_counts: dict[str, int],
) -> dict[str, Any]:
    normalized_checks = [
        {
            "check_id": item["check_id"],
            "command_id": item.get("command_id", item["check_id"]),
            "status": item["status"],
            "outcome_sha256": item["outcome_sha256"],
        }
        for item in checks
    ]
    report: dict[str, Any] = {
        "schema_version": "1.0.0",
        "evidence_id": "evidence_phase_03_automated_preflight_rev_001",
        "claim": "automated sprint slice passed",
        "value_classification": "HYPOTHESIS",
        "recorded_at_utc": recorded_at_utc,
        "implementation_revision": IMPLEMENTATION_REVISION,
        "fixture": {
            "fixture_id": "FX-TRANSACTION-001",
            "fixture_revision": "rev-001",
            "manifest_sha256": PINNED_MANIFEST_SHA256,
            "cases_sha256": PINNED_CASES_SHA256,
            "expected_traces_sha256": PINNED_TRACES_SHA256,
        },
        "oracle": {
            "case_count": 24,
            "operation_order": ["place", "replace", "remove", "restore"],
            "proposal_assertions": ["place_accepted", "replace_blocked_nonmutating", "remove_blocked_nonmutating", "restore_accepted_not_preauthorized", "injection_rejected"],
            "result_schema_sha256": PINNED_RESULT_SCHEMA_SHA256,
        },
        "runtime_runs": runtime_runs,
        "checks": normalized_checks,
        "counts": {"runtime_count": 3, "runs_per_runtime": 2, "case_count": 24, "semantic_disagreements": 0, "provenance_disagreements": 0},
        "pending_gates": {gate: "PENDING" for gate in PENDING_GATES},
        "pending_evidence": ["physical device observations", "reconnect and replication campaign", "proxy and license qualification", "complete adversarial agent campaign"],
        "limitations": [
            "Local deterministic automation does not complete GATE-009, GATE-010, or GATE-011.",
            "Physical, reconnect, replication, proxy, license, visual, and human evidence remain pending.",
            "This report supports only the approved automated sprint slice and does not establish full P0 completion.",
        ],
        "source_bindings": source_bindings,
        "working_tree_counts": working_tree_counts,
        "privacy": {"raw_room_data_included": False, "user_content_included": False, "machine_paths_included": False, "identifiers_included": False, "credentials_included": False, "human_observations_included": False},
    }
    report["preflight_sha256"] = _sha256(canonical_bytes(report))
    return report


def validate_evidence(report: dict[str, Any]) -> None:
    required = {
        "schema_version", "evidence_id", "claim", "value_classification", "recorded_at_utc",
        "implementation_revision", "fixture", "oracle", "runtime_runs", "checks", "counts",
        "pending_gates", "pending_evidence", "limitations", "source_bindings", "working_tree_counts",
        "privacy", "preflight_sha256",
    }
    if not isinstance(report, dict) or set(report) != required:
        raise EvidenceError("evidence:root")
    if report["schema_version"] != "1.0.0" or report["evidence_id"] != "evidence_phase_03_automated_preflight_rev_001":
        raise EvidenceError("evidence:identity")
    if report["claim"] != "automated sprint slice passed" or report["value_classification"] != "HYPOTHESIS":
        raise EvidenceError("evidence:claim")
    if not isinstance(report["recorded_at_utc"], str) or not UTC_TIMESTAMP.fullmatch(report["recorded_at_utc"]):
        raise EvidenceError("evidence:time")
    if report["implementation_revision"] != IMPLEMENTATION_REVISION:
        raise EvidenceError("evidence:implementation_revision")
    expected_fixture = {"fixture_id": "FX-TRANSACTION-001", "fixture_revision": "rev-001", "manifest_sha256": PINNED_MANIFEST_SHA256, "cases_sha256": PINNED_CASES_SHA256, "expected_traces_sha256": PINNED_TRACES_SHA256}
    if report["fixture"] != expected_fixture:
        raise EvidenceError("evidence:fixture")
    expected_oracle = {"case_count": 24, "operation_order": ["place", "replace", "remove", "restore"], "proposal_assertions": ["place_accepted", "replace_blocked_nonmutating", "remove_blocked_nonmutating", "restore_accepted_not_preauthorized", "injection_rejected"], "result_schema_sha256": PINNED_RESULT_SCHEMA_SHA256}
    if report["oracle"] != expected_oracle:
        raise EvidenceError("evidence:oracle")
    if set(report["runtime_runs"]) != set(RUNTIME_IDENTITIES):
        raise EvidenceError("evidence:runtimes")
    for runtime, run in report["runtime_runs"].items():
        if not isinstance(run, dict) or set(run) != {"byte_identical", "run_count", "result_sha256", "source_tree_sha256"} or run["byte_identical"] is not True or run["run_count"] != 2 or not HEX_DIGEST.fullmatch(run["result_sha256"]) or not HEX_DIGEST.fullmatch(run["source_tree_sha256"]):
            raise EvidenceError(f"evidence:runtime:{runtime}")
    if not isinstance(report["checks"], list) or [item.get("check_id") for item in report["checks"] if isinstance(item, dict)] != list(EXPECTED_FULL_CHECKS):
        raise EvidenceError("evidence:checks")
    for item in report["checks"]:
        if set(item) != {"check_id", "command_id", "status", "outcome_sha256"} or item["command_id"] != item["check_id"] or item["status"] != "PASS" or not HEX_DIGEST.fullmatch(item["outcome_sha256"]):
            raise EvidenceError("evidence:check")
    if report["counts"] != {"runtime_count": 3, "runs_per_runtime": 2, "case_count": 24, "semantic_disagreements": 0, "provenance_disagreements": 0}:
        raise EvidenceError("evidence:counts")
    if report["pending_gates"] != {gate: "PENDING" for gate in PENDING_GATES}:
        raise EvidenceError("evidence:pending_gates")
    expected_pending = ["physical device observations", "reconnect and replication campaign", "proxy and license qualification", "complete adversarial agent campaign"]
    if report["pending_evidence"] != expected_pending:
        raise EvidenceError("evidence:pending_evidence")
    expected_limitations = [
        "Local deterministic automation does not complete GATE-009, GATE-010, or GATE-011.",
        "Physical, reconnect, replication, proxy, license, visual, and human evidence remain pending.",
        "This report supports only the approved automated sprint slice and does not establish full P0 completion.",
    ]
    if report["limitations"] != expected_limitations:
        raise EvidenceError("evidence:limitations")
    if set(report["source_bindings"]) != {"comparator_sha256", "orchestrator_sha256", "result_schema_sha256"} or any(not HEX_DIGEST.fullmatch(value) for value in report["source_bindings"].values()):
        raise EvidenceError("evidence:source_bindings")
    if set(report["working_tree_counts"]) != {"tracked_modified", "untracked"} or any(type(value) is not int or value < 0 for value in report["working_tree_counts"].values()):
        raise EvidenceError("evidence:working_tree")
    if report["privacy"] != {"raw_room_data_included": False, "user_content_included": False, "machine_paths_included": False, "identifiers_included": False, "credentials_included": False, "human_observations_included": False}:
        raise EvidenceError("evidence:privacy")
    _walk_strings(report)
    digest = report["preflight_sha256"]
    if not isinstance(digest, str) or not HEX_DIGEST.fullmatch(digest):
        raise EvidenceError("evidence:digest")
    unsigned = dict(report)
    unsigned.pop("preflight_sha256")
    if digest != _sha256(canonical_bytes(unsigned)):
        raise EvidenceError("evidence:digest")


def _atomic_publish(target: Path, data: bytes) -> None:
    target.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=".automated-preflight.", suffix=".tmp", dir=target.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o644)
        os.replace(temporary, target)
    except OSError as error:
        raise EvidenceError("evidence:atomic_publication") from error
    finally:
        try:
            temporary.unlink(missing_ok=True)
        except OSError:
            pass


def _source_bindings(root: Path) -> dict[str, str]:
    bindings = {
        "comparator_sha256": _sha256((root / COMPARATOR_RELATIVE_PATH).read_bytes()),
        "orchestrator_sha256": _sha256((root / ORCHESTRATOR_RELATIVE_PATH).read_bytes()),
        "result_schema_sha256": _sha256((root / RESULT_SCHEMA_RELATIVE_PATH).read_bytes()),
    }
    if bindings["result_schema_sha256"] != PINNED_RESULT_SCHEMA_SHA256:
        raise EvidenceError("source_binding:result_schema")
    return bindings


def _quick(root: Path, runtimes: dict[str, str]) -> tuple[list[dict[str, str]], dict[str, dict[str, Any]]]:
    checks: list[dict[str, str]] = []
    fixture = verify_transaction_fixture(root / MANIFEST_RELATIVE_PATH, repo_root=root)
    checks.append(_check_record("fixture_integrity", canonical_bytes({"manifest_sha256": fixture.manifest_sha256, "case_count": len(fixture.cases)})))
    swift_output = _run(
        [runtimes["swift"], "test", "--package-path", SWIFT_PACKAGE, "--filter", "PlaceReducerTests|RestoreReducerTests|TransactionAuthorityTests|TransactionStoreCrashTests|TransactionTraceExporterTests"],
        root=root,
        label="swift_transaction_tests",
    )
    checks.append(_check_record("swift_transaction_tests", swift_output))
    node_output = _run([runtimes["node"], "--test", "packages/contracts/test/transaction.test.mjs"], root=root, label="typescript_transaction_tests")
    checks.append(_check_record("typescript_transaction_tests", node_output))
    python_output = _run([runtimes["python"], "-m", "unittest", "tools.python.tests.test_transaction"], root=root, label="python_transaction_tests")
    checks.append(_check_record("python_transaction_tests", python_output))
    runtime_runs, agreement_output = _two_run_agreement(root, runtimes)
    identity = canonical_bytes({runtime: {"byte_identical": item["byte_identical"], "run_count": item["run_count"], "result_sha256": item["result_sha256"]} for runtime, item in runtime_runs.items()})
    checks.append(_check_record("producer_two_run_identity", identity))
    checks.append(_check_record("three_runtime_agreement", agreement_output))
    return checks, runtime_runs


def _full(root: Path, runtimes: dict[str, str], checks: list[dict[str, str]]) -> list[dict[str, str]]:
    xcode_common = ["xcodebuild", "-project", XCODE_PROJECT, "-scheme", "ReRoomDeviceProof", "-destination", XCODE_DESTINATION]
    model = _run([*xcode_common, "test", "-only-testing:ReRoomDeviceProofTests/RoomEditModelTests"], root=root, label="room_edit_model_tests")
    checks.append(_check_record("room_edit_model_tests", model))
    simulator_boundary = _reboot_booted_ui_simulator(root)
    ui = simulator_boundary + _run([*xcode_common, "test", "-only-testing:ReRoomDeviceProofUITests/RoomEditJourneyTests"], root=root, label="room_edit_ui_tests")
    checks.append(_check_record("room_edit_ui_tests", ui))
    debug = _run([*xcode_common, "-configuration", "Debug", "build"], root=root, label="debug_build")
    checks.append(_check_record("debug_build", debug))
    release = _run([*xcode_common, "-configuration", "Release", "build"], root=root, label="release_build")
    checks.append(_check_record("release_build", release))
    release_surface = _run(["scripts/verify-reroom-release-surface"], root=root, label="release_surface")
    checks.append(_check_record("release_surface", release_surface))
    checks.append(_check_record("tracked_secret_scan", _scan_tracked_secrets(root)))
    whitespace = _run(["git", "diff", "--check"], root=root, label="whitespace_check", timeout=60)
    checks.append(_check_record("whitespace_check", whitespace))
    return checks


def run(mode: str) -> None:
    root = REPOSITORY_IMPORT_ROOT.resolve()
    _require_bound_producer_sources(root)
    runtimes = _require_runtime_versions(root)
    checks, runtime_runs = _quick(root, runtimes)
    if mode == "quick":
        print("phase-03-transactions: PASS (quick; 3 runtimes x 2 runs; no evidence published)")
        return
    _full(root, runtimes, checks)
    if tuple(item["check_id"] for item in checks) != EXPECTED_FULL_CHECKS:
        raise EvidenceError("evidence:incomplete_checks")
    report = _evidence_template(
        recorded_at_utc=datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ"),
        checks=checks,
        runtime_runs=runtime_runs,
        source_bindings=_source_bindings(root),
        working_tree_counts=_working_tree_counts(root),
    )
    validate_evidence(report)
    _atomic_publish(root / EVIDENCE_RELATIVE_PATH, canonical_bytes(report) + b"\n")
    print("phase-03-transactions: PASS (full; automated sprint slice passed; deferred gates PENDING)")


def main(argv: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("mode", choices=("quick", "full"))
    arguments = parser.parse_args(argv)
    try:
        run(arguments.mode)
    except (EvidenceError, TransactionComparisonError, json.JSONDecodeError) as error:
        print(f"phase-03-transactions: FAIL ({error})", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
