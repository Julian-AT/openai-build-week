#!/bin/sh

set -eu

product_provenance="$TARGET_BUILD_DIR/$UNLOCALIZED_RESOURCES_FOLDER_PATH/ReRoomBuildProvenance.plist"

repository_root=$(/usr/bin/git -C "$SRCROOT" rev-parse --show-toplevel)

if ! /usr/bin/git -C "$repository_root" diff --quiet HEAD -- \
  docs/contracts \
  fixtures/contracts/1.0.0/rev-001/manifest.json \
  ios/Packages/ReRoomContracts/Package.resolved \
  ios/Packages/ReRoomContracts/Package.swift \
  ios/Packages/ReRoomContracts/Sources \
  ios/ReRoomDeviceProof/ReRoomDeviceProof \
  scripts/embed-ios-build-provenance
then
  exit 1
fi

project_relative="ios/ReRoomDeviceProof/ReRoomDeviceProof.xcodeproj/project.pbxproj"
project_path="$repository_root/$project_relative"

normalize_project() {
  /usr/bin/plutil -convert json -o - "$1" |
    /usr/bin/jq -S -c 'walk(if type == "object" then del(.DEVELOPMENT_TEAM) else . end)'
}

working_project=$(normalize_project "$project_path")
committed_project=$(
  /usr/bin/git -C "$repository_root" show "HEAD:$project_relative" |
    /usr/bin/plutil -convert json -o - -- - |
    /usr/bin/jq -S -c 'walk(if type == "object" then del(.DEVELOPMENT_TEAM) else . end)'
)

if [ "$working_project" != "$committed_project" ]; then
  exit 1
fi

revision=$(/usr/bin/git -C "$repository_root" rev-parse --verify HEAD)
fixture_manifest="$repository_root/fixtures/contracts/1.0.0/rev-001/manifest.json"
fixture_digest=$(/usr/bin/shasum -a 256 "$fixture_manifest")
fixture_digest=${fixture_digest%% *}
temporary_provenance="$DERIVED_FILE_DIR/ReRoomBuildProvenance.$$.plist"

printf '%s\n' "$revision" | /usr/bin/grep -Eq '^[0-9a-f]{40}$'
printf '%s\n' "$fixture_digest" | /usr/bin/grep -Eq '^[0-9a-f]{64}$'

mkdir -p "$DERIVED_FILE_DIR" "$(dirname "$product_provenance")"
trap 'rm -f "$temporary_provenance"' EXIT
/usr/bin/plutil -create xml1 "$temporary_provenance"
/usr/bin/plutil -replace implementation_revision -string "git:$revision" "$temporary_provenance"
/usr/bin/plutil -replace fixture_sha256 -string "$fixture_digest" "$temporary_provenance"
mv -f "$temporary_provenance" "$product_provenance"
