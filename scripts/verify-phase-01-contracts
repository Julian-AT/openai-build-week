#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

MANIFEST_CONTRACTS="fixtures/contracts/1.0.0/rev-001/manifest.json"
MANIFEST_JCS="fixtures/policies/RR-JCS-SHA256-1/rev-001/manifest.json"
MANIFEST_COORDS="fixtures/policies/RR-COORD-1/rev-001/manifest.json"
PREFLIGHT="${REROOM_PHASE01_AUTOMATED_PREFLIGHT:-evidence/device/phase-01/automated-preflight.json}"
PHYSICAL_DIR="${REROOM_PHASE01_EVIDENCE_DIR:-evidence/device/phase-01}"

fail() {
  printf 'phase-01 verification: FAIL (%s)\n' "$1" >&2
  exit 1
}

fixture_integrity() {
  python3 tools/verify/compare_results.py fixture-integrity \
    --manifest "$MANIFEST_CONTRACTS" \
    --manifest "$MANIFEST_JCS" \
    --manifest "$MANIFEST_COORDS"
}

evidence_checks() {
  python3 -m unittest tools.verify.tests.test_evidence_templates -v
  if [[ -f tools/verify/verify_evidence.py ]]; then
    python3 tools/verify/verify_evidence.py --fixtures evidence/fixtures
  fi
}

contract_checks() {
  python3 -m unittest tests.test_fixture_meta_schemas tools.verify.tests.test_compare_results -v
  if [[ -f tools/javascript/test/runner.test.mjs ]]; then
    node --test tools/javascript/test/runner.test.mjs
  fi
  if [[ -f tools/python/tests/test_runner.py ]]; then
    [[ -x .venv/bin/python ]] || fail 'missing_locked_python_environment'
    .venv/bin/python -m unittest tools.python.tests.test_runner -v
  fi
  if [[ -f ios/Packages/ReRoomContracts/Tests/ReRoomContractsTests/ContractValidationTests.swift ]]; then
    swift test --package-path ios/Packages/ReRoomContracts --filter ContractValidationTests
  fi
}

coordinate_checks() {
  python3 tools/verify/compare_results.py fixture-integrity --manifest "$MANIFEST_COORDS"
  if [[ -f tools/javascript/test/runner.test.mjs ]]; then
    node --test tools/javascript/test/runner.test.mjs
  fi
  if [[ -f tools/python/tests/test_runner.py ]]; then
    [[ -x .venv/bin/python ]] || fail 'missing_locked_python_environment'
    .venv/bin/python -m unittest tools.python.tests.test_runner -v
  fi
  if [[ -f ios/Packages/ReRoomContracts/Tests/ReRoomContractsTests/CoordinateMathTests.swift ]]; then
    swift test --package-path ios/Packages/ReRoomContracts --filter CoordinateMathTests
  fi
}

reference_checks() {
  [[ -x scripts/run-three-runtime-agreement ]] || fail 'missing_three_runtime_agreement'
  scripts/run-three-runtime-agreement
  for report in contract-agreement.json jcs-agreement.json coordinate-agreement.json; do
    [[ -f "evidence/compatibility/$report" ]] || fail "missing_reference_report:$report"
  done
}

quick_checks() {
  python3 -m unittest tools.verify.tests.test_release_test_bundle -v
  python3 tools/verify/verify_phase_01_dependencies.py \
    --audit evidence/dependencies/phase-01-package-audit.json \
    --package-json tools/javascript/package.json \
    --package-lock tools/javascript/package-lock.json \
    --requirements-in tools/python/requirements.in \
    --requirements-lock tools/python/requirements.lock \
    --swift-package ios/Packages/ReRoomContracts/Package.swift \
    --swift-resolved ios/Packages/ReRoomContracts/Package.resolved
  fixture_integrity
  evidence_checks
  contract_checks
  coordinate_checks
}

require_full_surface() {
  local required
  for required in \
    scripts/run-reference-parity \
    scripts/run-three-runtime-agreement \
    scripts/verify-reroom-release-surface \
    tools/verify/verify_evidence.py \
    tools/javascript/test/parity-mutations.test.mjs \
    tools/python/tests/test_parity_mutations.py \
    ios/ReRoomDeviceProof/ReRoomDeviceProof.xcodeproj/project.pbxproj; do
    [[ -e "$required" ]] || fail "missing_full_component:$required"
  done
  [[ -x .venv/bin/python ]] || fail 'missing_locked_python_environment'
  [[ -n "${REROOM_CANDIDATE_ARTIFACT:-}" ]] || fail 'missing_candidate_artifact'
  [[ -e "$REROOM_CANDIDATE_ARTIFACT" ]] || fail 'missing_candidate_artifact'
  [[ "${REROOM_SIGNING_RESULT:-}" == 'pass' ]] || fail 'candidate_signing_not_pass'
}

secret_and_diff_checks() {
  if git grep -nE '(AKIA[0-9A-Z]{16}|-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----|xox[baprs]-[A-Za-z0-9-]{10,})' -- . ':!evidence/fixtures/**'; then
    fail 'tracked_secret_pattern'
  fi
  git diff --check
}

emit_preflight() {
  mkdir -p "$(dirname "$PREFLIGHT")"
  PREFLIGHT_PATH="$PREFLIGHT" CANDIDATE_PATH="$REROOM_CANDIDATE_ARTIFACT" python3 - <<'PY'
import hashlib, json, os, subprocess, tempfile
from datetime import datetime, timezone
from pathlib import Path
from jsonschema import Draft202012Validator

root = Path.cwd()
candidate = Path(os.environ["CANDIDATE_PATH"])
digest = hashlib.sha256()
if candidate.is_file():
    digest.update(candidate.read_bytes())
else:
    for path in sorted(item for item in candidate.rglob("*") if item.is_file()):
        digest.update(path.relative_to(candidate).as_posix().encode("utf-8") + b"\0")
        digest.update(path.read_bytes())
candidate_sha = digest.hexdigest()
fixture_refs = []
for path in (
    root / "fixtures/contracts/1.0.0/rev-001/manifest.json",
    root / "fixtures/policies/RR-JCS-SHA256-1/rev-001/manifest.json",
    root / "fixtures/policies/RR-COORD-1/rev-001/manifest.json",
):
    value = json.loads(path.read_text())
    fixture_refs.append({"fixture_id": value["fixture_id"], "fixture_revision": value["fixture_revision"], "sha256": hashlib.sha256(path.read_bytes()).hexdigest()})
xcode = subprocess.run(["xcodebuild", "-version"], check=True, capture_output=True, text=True).stdout.splitlines()[0]
head = subprocess.run(["git", "rev-parse", "HEAD"], check=True, capture_output=True, text=True).stdout.strip()
report = {
    "schema_version": "2.0.0", "gate_id": "GATE-013", "gate_state": "RUNNING", "decision_actor": "automation",
    "recorded_at_utc": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), "implementation_revision": f"git:{head}",
    "test_ids": ["TST-CONTRACT-001", "TST-COORD-001", "TST-DEVICE-001"],
    "requirement_ids": ["NFR-CONTRACT-001", "NFR-COORD-001", "OPS-DEVICE-001"], "adr_ids": ["ADR-002", "ADR-003"],
    "fixture_refs": fixture_refs,
    "environment": {"device_model": None, "os_version": None, "xcode_version": xcode, "runtime_tier": "local-automated-preflight", "capability_flags": {"camera_permission": "not_tested", "arkit_world_tracking": "not_tested", "plane_detection": "not_tested", "lidar_required": False}, "signing_result": "pass"},
    "value_classification": "TARGET",
    "evidence_artifacts": [{"opaque_artifact_id": "opaque-phase-01-candidate-build", "artifact_kind": "metric_output", "artifact_role": "supporting_evidence", "sha256": candidate_sha, "external_retention": True}],
    "automated_report_sha256": None, "operator_checklist_sha256": None, "locked_decision_change_id": None, "prd_sha256": None, "affected_adr_sha256": [],
}
schema = json.loads((root / "evidence/templates/gate-report.schema.json").read_text())
Draft202012Validator(schema).validate(report)
target = Path(os.environ["PREFLIGHT_PATH"])
fd, temporary = tempfile.mkstemp(prefix=f".{target.name}.", dir=target.parent)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        json.dump(report, handle, indent=2, sort_keys=True)
        handle.write("\n")
        handle.flush(); os.fsync(handle.fileno())
    os.replace(temporary, target)
    directory_fd = os.open(target.parent, os.O_RDONLY)
    try: os.fsync(directory_fd)
    finally: os.close(directory_fd)
finally:
    if os.path.exists(temporary): os.unlink(temporary)
PY
  python3 tools/verify/verify_evidence.py --file "$PREFLIGHT"
}

full_checks() {
  require_full_surface
  quick_checks
  scripts/run-reference-parity
  node --test tools/javascript/test/parity-mutations.test.mjs
  .venv/bin/python -m unittest tools.python.tests.test_parity_mutations tools.verify.tests.test_reference_parity -v
  swift test --package-path ios/Packages/ReRoomContracts
  scripts/run-three-runtime-agreement
  xcodebuild test -project ios/ReRoomDeviceProof/ReRoomDeviceProof.xcodeproj -scheme ReRoomDeviceProof -configuration Debug -destination 'platform=iOS Simulator,name=iPhone 17' CODE_SIGNING_ALLOWED=NO
  xcodebuild test -project ios/ReRoomDeviceProof/ReRoomDeviceProof.xcodeproj -scheme ReRoomDeviceProof -configuration Release -destination 'platform=iOS Simulator,name=iPhone 17' CODE_SIGNING_ALLOWED=NO
  xcodebuild build -project ios/ReRoomDeviceProof/ReRoomDeviceProof.xcodeproj -scheme ReRoomDeviceProof -configuration Release -sdk iphonesimulator CODE_SIGNING_ALLOWED=NO
  scripts/verify-reroom-release-surface
  python3 tools/verify/verify_evidence.py --fixtures evidence/fixtures
  secret_and_diff_checks
  emit_preflight
}

gate_checks() {
  local gate_013="$PHYSICAL_DIR/gate-013-report.json"
  local gate_002="$PHYSICAL_DIR/gate-002-report.json"
  [[ -f "$PREFLIGHT" ]] || fail 'missing_successful_full_artifact'
  PREFLIGHT_PATH="$PREFLIGHT" GATE_013="$gate_013" GATE_002="$gate_002" PHYSICAL_DIR="$PHYSICAL_DIR" python3 - <<'PY'
import hashlib, json, os
from pathlib import Path
from jsonschema import Draft202012Validator
from tools.verify.verify_evidence import verify_files

root = Path.cwd()
report_schema = json.loads((root / "evidence/templates/gate-report.schema.json").read_text())
preflight_path = Path(os.environ["PREFLIGHT_PATH"])
preflight = json.loads(preflight_path.read_text())
Draft202012Validator(report_schema).validate(preflight)
if not (preflight["gate_id"] == "GATE-013" and preflight["gate_state"] == "RUNNING" and preflight["decision_actor"] == "automation" and preflight["environment"]["signing_result"] == "pass"):
    raise SystemExit("gate: invalid successful-full artifact")
if not any(item["opaque_artifact_id"] == "opaque-phase-01-candidate-build" for item in preflight["evidence_artifacts"]):
    raise SystemExit("gate: preflight is not candidate-bound")
preflight_sha = hashlib.sha256(preflight_path.read_bytes()).hexdigest()
states = []
for gate_id, env_name in (("GATE-013", "GATE_013"), ("GATE-002", "GATE_002")):
    report_path = Path(os.environ[env_name])
    if not report_path.is_file(): raise SystemExit(f"gate: missing {gate_id} report")
    report = json.loads(report_path.read_text())
    Draft202012Validator(report_schema).validate(report)
    if report["gate_id"] != gate_id: raise SystemExit(f"gate: wrong {gate_id} identity")
    state = report["gate_state"]
    states.append(state)
    checklist_path = Path(os.environ["PHYSICAL_DIR"]) / f"{gate_id.lower()}-operator-checklist.json"
    if state == "GREEN":
        if not checklist_path.is_file(): raise SystemExit(f"gate: missing {gate_id} checklist")
        if report["automated_report_sha256"] != preflight_sha: raise SystemExit(f"gate: unbound {gate_id} preflight")
        verify_files(report_path, checklist_path)
if states != ["GREEN", "GREEN"]:
    raise SystemExit(f"gate: physical states are {','.join(states)}")
PY
  if [[ -f tools/verify/verify_evidence.py ]]; then
    python3 tools/verify/verify_evidence.py --file "$gate_013" --checklist "$PHYSICAL_DIR/gate-013-operator-checklist.json"
    python3 tools/verify/verify_evidence.py --file "$gate_002" --checklist "$PHYSICAL_DIR/gate-002-operator-checklist.json"
  fi
  printf 'gate: PASS (GATE-013=GREEN,GATE-002=GREEN)\n'
}

mode="${1:-}"
[[ $# -eq 1 ]] || fail 'usage: verify-phase-01-contracts MODE'
case "$mode" in
  fixture-integrity) fixture_integrity ;;
  evidence) evidence_checks ;;
  contracts) contract_checks ;;
  coords) coordinate_checks ;;
  references) reference_checks ;;
  quick) quick_checks ;;
  full) full_checks ;;
  gate) gate_checks ;;
  *) fail "unknown_mode:$mode" ;;
esac
