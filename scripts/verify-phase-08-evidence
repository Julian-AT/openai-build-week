#!/usr/bin/env python3
"""Publish and verify the sanitized Phase 8 evidence/status pair."""

from __future__ import annotations

import hashlib
import json
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from tools.verify import verify_phase_08_evidence as verifier  # noqa: E402

INDEX = ROOT / verifier.INDEX_PATH
GATES = ROOT / verifier.GATES_PATH

AUTOMATED_INPUTS = (
    ("EVID-P08-PHASE02-AUTOMATED", "evidence/capture/phase-02/automated-preflight.json", ["NFR-RESILIENCE-001"], ["GATE-001"], "scripts/verify-phase-02-capture-replay"),
    ("EVID-P08-PHASE03-AUTOMATED", "evidence/transactions/phase-03/automated-preflight.json", ["NFR-RESILIENCE-001", "SEC-AGENT-001"], ["GATE-009", "GATE-010"], "scripts/verify-phase-03-transactions"),
    ("EVID-P08-PHASE04-AUTOMATED", "evidence/targeting/phase-04/automated-preflight.json", ["SEC-AGENT-001"], ["GATE-003", "GATE-004", "GATE-005"], "scripts/verify-phase-04-targeting"),
    ("EVID-P08-PHASE05-AUTOMATED", "evidence/replacement/phase-05/automated-preflight.json", ["NFR-RESILIENCE-001", "SEC-CREDENTIAL-001"], ["GATE-003", "GATE-009", "GATE-011"], "scripts/verify-phase-05-replacement"),
    ("EVID-P08-PHASE06-AUTOMATED", "evidence/removal/phase-06/automated-preflight.json", ["NFR-RESILIENCE-001", "SEC-CREDENTIAL-001"], ["GATE-003", "GATE-006", "GATE-009"], "scripts/verify-phase-06-removal"),
    ("EVID-P08-PHASE07-AUTOMATED", "evidence/web/phase-07/automated-preflight.json", ["NFR-RESILIENCE-001", "SEC-CREDENTIAL-001"], ["GATE-008"], "scripts/verify-phase-07-b0"),
    ("EVID-P08-HARDENING-AUTOMATED", "evidence/hardening/phase-08/automated-preflight.json", ["NFR-RESILIENCE-001", "SEC-AGENT-001", "SEC-CREDENTIAL-001"], ["GATE-009", "GATE-010"], "scripts/verify-phase-08-hardening --verify-evidence"),
    ("EVID-P08-SPRINT-BOM", "evidence/hardening/phase-08/sprint-bom.json", ["OPS-LICENSE-001"], ["GATE-011"], "scripts/verify-phase-08-hardening --verify-evidence"),
)

FORMAL_REPORTS = {
    "GATE-001": ("evidence/capture/phase-02/gate-001-report.json", None),
    "GATE-002": ("evidence/device/phase-01/gate-002-report.json", "evidence/device/phase-01/gate-002-operator-checklist.json"),
    "GATE-013": ("evidence/device/phase-01/gate-013-report.json", "evidence/device/phase-01/gate-013-operator-checklist.json"),
}

DISPOSITIONS = {
    "GATE-001": "running", "GATE-002": "retained_green", "GATE-003": "deferred_pending",
    "GATE-004": "fallback_active", "GATE-005": "fallback_active", "GATE-006": "deferred_pending",
    "GATE-007": "fallback_active", "GATE-008": "deferred_pending", "GATE-009": "deferred_pending",
    "GATE-010": "deferred_pending", "GATE-011": "blocked", "GATE-012": "fallback_active",
    "GATE-013": "retained_green", "GATE-014": "fallback_active",
}


def run_checked(command: list[str]) -> None:
    completed = subprocess.run(command, cwd=ROOT, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if completed.returncode != 0:
        verifier.reject("E08I_UPSTREAM_AUTHORITY")


def revision_and_time() -> tuple[str, str]:
    revision = subprocess.run(["git", "rev-parse", "HEAD"], cwd=ROOT, check=True, text=True, capture_output=True).stdout.strip()
    recorded = subprocess.run(["git", "show", "-s", "--format=%cI", "HEAD"], cwd=ROOT, check=True, text=True, capture_output=True).stdout.strip()
    return "git:" + revision, recorded.replace("+00:00", "Z")


def validate_authorities() -> None:
    if shutil.disk_usage(ROOT).free < 128 * 1024 * 1024:
        verifier.reject("E08I_DISK_PREFLIGHT")
    run_checked([str(ROOT / "scripts/verify-phase-08-hardening"), "--verify-evidence"])
    run_checked([sys.executable, "-m", "unittest", "tools.verify.tests.test_phase_08_evidence"])
    for gate_id, (report, checklist) in FORMAL_REPORTS.items():
        command = [sys.executable, "tools/verify/verify_evidence.py", "--file", report]
        if checklist:
            command.extend(["--checklist", checklist])
        run_checked(command)


def _revision_from(path: Path, fallback: str) -> str:
    value = json.loads(path.read_text(encoding="utf-8"))
    revision = value.get("implementation_revision")
    return revision if isinstance(revision, str) and verifier.REV_RE.fullmatch(revision) else fallback


def build_entries(current_revision: str) -> list[dict[str, object]]:
    entries: list[dict[str, object]] = []
    for evidence_id, relative, requirements, gates, procedure in AUTOMATED_INPUTS:
        path = ROOT / relative
        entries.append({
            "evidence_id": evidence_id, "implementation_revision": _revision_from(path, current_revision),
            "location": relative, "sha256": verifier.file_sha256(path),
            "requirement_ids": requirements, "gate_ids": gates, "procedure": procedure,
            "classification": "automated_check", "state": "VERIFIED",
            "provenance": "phase_08_bom" if evidence_id == "EVID-P08-SPRINT-BOM" else "phase_automated_report",
        })
    for gate_id, (relative, _checklist) in FORMAL_REPORTS.items():
        path = ROOT / relative
        report = json.loads(path.read_text(encoding="utf-8"))
        entries.append({
            "evidence_id": f"EVID-P08-{gate_id}-FORMAL-REPORT", "implementation_revision": report["implementation_revision"],
            "location": relative, "sha256": verifier.file_sha256(path),
            "requirement_ids": report["requirement_ids"], "gate_ids": [gate_id],
            "procedure": "Validate canonical gate report and any required operator checklist.",
            "classification": "human_observation", "state": "VERIFIED", "provenance": "canonical_gate_report",
        })
    pending = (
        ("EVID-P08-DEVICE-SMOKE-PENDING", "opaque:device-smoke-not-retained", ["OPS-GOLDEN-001"], ["GATE-001", "GATE-003"], "device_smoke", "Run the signed-device procedure in docs/demo/PHASE_08_DEMO_RUNBOOK.md."),
        ("EVID-P08-BROWSER-SMOKE-PENDING", "opaque:browser-smoke-not-retained", ["OPS-GOLDEN-001"], ["GATE-008"], "browser_smoke", "Run the real-browser procedure in docs/demo/PHASE_08_DEMO_RUNBOOK.md."),
        ("EVID-P08-GOLDEN-HUMAN-PENDING", "opaque:golden-human-observation-not-retained", ["OPS-GOLDEN-001"], ["GATE-003", "GATE-006", "GATE-008"], "human_observation", "Complete 5/5 only after blocking gates are green."),
        ("EVID-P08-LICENSE-BLOCKED", "opaque:shipping-license-decision-not-recorded", ["OPS-LICENSE-001"], ["GATE-011"], "human_observation", "Record root license and proxy use-and-redistribution approval."),
        ("EVID-P08-SUBMISSION-PENDING", "opaque:public-submission-not-performed", ["OPS-SUBMISSION-001"], [], "external_submission", "Follow docs/demo/BUILD_WEEK_SUBMISSION_HANDOFF.md as a human-owned action."),
    )
    for evidence_id, location, requirements, gates, classification, procedure in pending:
        entries.append({
            "evidence_id": evidence_id, "implementation_revision": current_revision,
            "location": location, "sha256": None, "requirement_ids": requirements, "gate_ids": gates,
            "procedure": procedure, "classification": classification,
            "state": "BLOCKED" if evidence_id == "EVID-P08-LICENSE-BLOCKED" else "PENDING",
            "provenance": "procedure_only",
        })
    return entries


def build_gate_rows() -> list[dict[str, object]]:
    rows: list[dict[str, object]] = []
    for gate_id in verifier.GATE_IDS:
        formal = None
        formal_state = "NO_REPORT"
        if gate_id in FORMAL_REPORTS:
            relative = FORMAL_REPORTS[gate_id][0]
            canonical = json.loads((ROOT / relative).read_text(encoding="utf-8"))
            formal_state = canonical["gate_state"]
            formal = {"path": relative, "sha256": verifier.file_sha256(ROOT / relative)}
        evidence_ids = [f"EVID-P08-{gate_id}-FORMAL-REPORT"] if formal else []
        if gate_id == "GATE-011":
            evidence_ids.extend(["EVID-P08-LICENSE-BLOCKED", "EVID-P08-SPRINT-BOM"])
        rows.append({
            "gate_id": gate_id, "formal_state": formal_state, "formal_report": formal,
            "sprint_disposition": DISPOSITIONS[gate_id], "evidence_ids": sorted(evidence_ids),
        })
    return rows


def requirement_rows() -> list[dict[str, str]]:
    rows = {
        "NFR-LATENCY-001": ("pending", "Collect canonical synchronized p50/p95/max stage distributions; benchmark runtime tiers only if replacing fallbacks."),
        "NFR-RESILIENCE-001": ("partial", "Run the full GATE-001 and GATE-009 termination, reconnect, and worker fault campaigns."),
        "OPS-GOLDEN-001": ("pending", "After blocking gates are green, retain five consecutive signed-device journeys plus matching B0 replay."),
        "OPS-LICENSE-001": ("blocked", "Record a root product license and explicit proxy use-and-redistribution approval, then complete GATE-011."),
        "OPS-SUBMISSION-001": ("pending", "A human must recheck rules, approve media, choose the Session ID, and submit."),
        "SEC-AGENT-001": ("evidence_present", "Retain automated typed/injection evidence and complete the formal GATE-010 campaign."),
        "SEC-CREDENTIAL-001": ("evidence_present", "Retain source/bundle scan evidence and complete the formal GATE-010 campaign."),
    }
    return [{"requirement_id": key, "trace_state": value[0], "resume_procedure": value[1]} for key, value in sorted(rows.items())]


def build_documents(
    revision: str | None = None, recorded_at: str | None = None,
) -> tuple[dict[str, object], dict[str, object]]:
    if revision is None or recorded_at is None:
        revision, recorded_at = revision_and_time()
    index = verifier.seal_index(verifier.build_index(
        implementation_revision=revision, recorded_at_utc=recorded_at, entries=build_entries(revision),
    ))
    gates = verifier.seal_gates(verifier.build_gate_report(
        implementation_revision=revision, recorded_at_utc=recorded_at,
        gate_rows=build_gate_rows(), requirement_rows=requirement_rows(),
    ))
    verifier.validate_index(index, root=ROOT, require_complete=True)
    verifier.validate_gate_report(gates, root=ROOT, require_complete=True)
    return index, gates


def full() -> None:
    validate_authorities()
    index, gates = build_documents()
    verifier.publish_pair(INDEX, GATES, index, gates, root=ROOT)
    print(json.dumps({"status": "PASS", "classification": "automated_check", "device_smoke": "PENDING", "browser_smoke": "PENDING", "submission": "PENDING"}, sort_keys=True))


def verify_published() -> None:
    validate_authorities()
    index = json.loads(INDEX.read_text(encoding="utf-8"))
    gates = json.loads(GATES.read_text(encoding="utf-8"))
    verifier.validate_index(index, root=ROOT, require_complete=True)
    verifier.validate_gate_report(gates, root=ROOT, require_complete=True)
    if index["implementation_revision"] != gates["implementation_revision"] or index["recorded_at_utc"] != gates["recorded_at_utc"]:
        verifier.reject("E08I_REVISION_COHERENCE")
    bound_revision = index["implementation_revision"].removeprefix("git:")
    producer_inputs = [
        "tools/verify/verify_phase_08_evidence.py",
        "tools/verify/tests/test_phase_08_evidence.py",
        "scripts/verify-phase-08-evidence",
        verifier.RUNBOOK_PATH,
        verifier.HANDOFF_PATH,
        *[item[1] for item in AUTOMATED_INPUTS],
        *[item[0] for item in FORMAL_REPORTS.values()],
        *[item[1] for item in FORMAL_REPORTS.values() if item[1]],
    ]
    bound = subprocess.run(["git", "cat-file", "-e", f"{bound_revision}^{{commit}}"], cwd=ROOT, check=False)
    drift = subprocess.run(["git", "diff", "--quiet", bound_revision, "HEAD", "--", *producer_inputs], cwd=ROOT, check=False)
    if bound.returncode != 0 or drift.returncode != 0:
        verifier.reject("E08I_PRODUCER_DRIFT")
    expected_index, expected_gates = build_documents(index["implementation_revision"], index["recorded_at_utc"])
    if index != expected_index or gates != expected_gates:
        verifier.reject("E08I_EVIDENCE_DRIFT")
    print(json.dumps({"status": "PASS", "requirements_completed": [], "shipping": "BLOCKED", "submission": "PENDING"}, sort_keys=True))


def main() -> int:
    try:
        if sys.argv[1:] == ["full"]:
            full()
        elif sys.argv[1:] == ["--verify-evidence"]:
            verify_published()
        else:
            verifier.reject("E08I_MODE")
        return 0
    except (verifier.EvidenceRejected, OSError, ValueError, subprocess.SubprocessError, json.JSONDecodeError):
        print(json.dumps({"status": "FAILED", "code": "E08I_VALIDATION"}, sort_keys=True), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
