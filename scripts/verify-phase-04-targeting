    "ar_session_raycast_tests": "xcodebuild focused ARSessionPolicyTests",
    "compositor_descriptor": "closed six-layer descriptor assertion",
    "production_dependency_audit": "static production dependency audit",
    "local_render_independence": "static representable callback audit",
    "mutation_tests": "python3 -m unittest tools.verify.tests.test_phase_04_targeting",
    "room_edit_ui_tests": "xcodebuild focused RoomEditJourneyTests on isolated simulator",
    "debug_build": "xcodebuild Debug simulator build",
    "release_build": "xcodebuild Release simulator build",
    "release_surface": "scripts/verify-reroom-release-surface",
    "tracked_secret_scan": "tracked file credential pattern scan",
    "whitespace_check": "git diff --check",
