#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
EVIDENCE_FILE="$ROOT_DIR/evidence/web/phase-07/automated-preflight.json"

cd "$ROOT_DIR"
export NEXT_TELEMETRY_DISABLED=1
export TZ=UTC
export LC_ALL=C

if [[ "${1:-full}" == "--verify-evidence" ]]; then
  if [[ "$#" -ne 1 ]]; then
    echo "phase-07-b0: FAIL: arguments" >&2
    exit 2
  fi
  exec /usr/bin/env python3 -m tools.verify.verify_phase_07_b0 --verify-evidence "$EVIDENCE_FILE"
fi

if [[ "${1:-full}" != "full" || "$#" -gt 1 ]]; then
  echo "phase-07-b0: FAIL: arguments" >&2
  exit 2
fi

PHASE07_TMP="$(mktemp -d "${TMPDIR:-/tmp}/reroom-phase-07-b0.XXXXXX")"
RESULTS_DIR="$PHASE07_TMP/results"
RAW_DIR="$PHASE07_TMP/raw"
HTTP_BODY="$PHASE07_TMP/local-http-response"
SOURCE_BACKUP_DIR="$PHASE07_TMP/source-backup"
SERVER_PID=""
SOURCE_RESTORED=0
mkdir -p "$RESULTS_DIR" "$RAW_DIR" "$SOURCE_BACKUP_DIR"
cp web/next-env.d.ts "$SOURCE_BACKUP_DIR/next-env.d.ts"
cp web/tsconfig.json "$SOURCE_BACKUP_DIR/tsconfig.json"

restore_generated_sources() {
  if [[ "$SOURCE_RESTORED" -eq 0 ]]; then
    cp "$SOURCE_BACKUP_DIR/next-env.d.ts" web/next-env.d.ts
    cp "$SOURCE_BACKUP_DIR/tsconfig.json" web/tsconfig.json
    SOURCE_RESTORED=1
  fi
}

cleanup() {
  if [[ -n "$SERVER_PID" ]]; then
    kill "$SERVER_PID" >/dev/null 2>&1 || true
    wait "$SERVER_PID" >/dev/null 2>&1 || true
  fi
  restore_generated_sources
  if [[ -n "$PHASE07_TMP" && -d "$PHASE07_TMP" ]]; then
    rm -rf -- "$PHASE07_TMP"
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

fail() {
  echo "phase-07-b0: FAIL: $1" >&2
  exit 1
}

record_pass() {
  printf '%s: PASS\n' "$1" > "$RESULTS_DIR/$1.pass"
}

run_check() {
  local check_id="$1"
  shift
  if ! "$@" > "$RAW_DIR/$check_id.log" 2>&1; then
    fail "$check_id"
  fi
  record_pass "$check_id"
}

if [[ "$(node --version 2>/dev/null || true)" != "v22.22.3" ]]; then
  fail "node_version"
fi
if [[ "$(npm --version 2>/dev/null || true)" != "10.9.8" ]]; then
  fail "npm_version"
fi

if ! npm --prefix tools/javascript ci --ignore-scripts --no-audit --no-fund > "$RAW_DIR/tools-install.log" 2>&1; then
  fail "tools_lock_install"
fi
if ! npm --prefix web ci --ignore-scripts --no-audit --no-fund > "$RAW_DIR/web-install.log" 2>&1; then
  fail "web_lock_install"
fi

run_check phase_02_exact_replay node --test tools/javascript/test/replay.test.mjs
run_check web_projection_timeline npm --prefix web test
run_check web_typecheck npm --prefix web run typecheck
run_check web_production_build npm --prefix web run build
restore_generated_sources

if ! /usr/bin/env python3 -m tools.verify.verify_phase_07_b0 --verify-source > "$RAW_DIR/source-verifier.log" 2>&1; then
  fail "source_closure"
fi
if rg -q 'node:child_process|tools/javascript/src/replay\.ts|finalized-one-frame\.rrcap/manifest\.json' web/.next/static/chunks; then
  fail "source_closure"
fi
record_pass source_closure

LOOPBACK_PORT="$(/usr/bin/env python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()')"
(
  cd web
  exec ./node_modules/.bin/next start -H 127.0.0.1 -p "$LOOPBACK_PORT"
) > "$RAW_DIR/server.log" 2>&1 &
SERVER_PID="$!"

HTTP_READY=0
for _attempt in {1..60}; do
  if curl --fail --silent --show-error --max-time 10 "http://127.0.0.1:$LOOPBACK_PORT/" --output "$HTTP_BODY" 2> "$RAW_DIR/curl.log"; then
    HTTP_READY=1
    break
  fi
  sleep 0.1
done
if [[ "$HTTP_READY" -ne 1 ]]; then
  fail "local_http_smoke"
fi
run_check local_http_smoke /usr/bin/env python3 -m tools.verify.verify_phase_07_b0 --verify-http "$HTTP_BODY"

kill "$SERVER_PID" >/dev/null 2>&1 || true
wait "$SERVER_PID" >/dev/null 2>&1 || true
SERVER_PID=""

IMPLEMENTATION_REVISION="git:$(git rev-parse HEAD)"
if ! /usr/bin/env python3 -m tools.verify.verify_phase_07_b0 \
  --generate \
  --results-dir "$RESULTS_DIR" \
  --output "$EVIDENCE_FILE" \
  --implementation-revision "$IMPLEMENTATION_REVISION" \
  > "$RAW_DIR/generation.log" 2>&1; then
  fail "evidence_generation"
fi

if ! /usr/bin/env python3 -m tools.verify.verify_phase_07_b0 --verify-evidence "$EVIDENCE_FILE" > "$RAW_DIR/evidence-verifier.log" 2>&1; then
  fail "evidence_verification"
fi

echo "phase_07_b0_full: PASS"
