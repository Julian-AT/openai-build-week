{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reroom:evidence-schema:gate-report:2",
  "title": "GateReportV2",
  "description": "Closed, sanitized gate-decision record. Raw evidence remains external and is referenced only by opaque ID and lowercase SHA-256. Human decisions bind a non-circular final-report decision payload, an unsigned checklist payload, the exact signed checklist bytes, and one externally retained operator-attestation ballot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate_id",
    "gate_state",
    "decision_actor",
    "recorded_at_utc",
    "implementation_revision",
    "test_ids",
    "requirement_ids",
    "adr_ids",
    "fixture_refs",
    "environment",
    "value_classification",
    "evidence_artifacts",
    "automated_report_sha256",
    "operator_checklist_sha256",
    "locked_decision_change_id",
    "prd_sha256",
    "affected_adr_sha256"
  ],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "gate_id": { "$ref": "#/$defs/gateId" },
    "gate_state": {
      "enum": ["UNRUN", "RUNNING", "GREEN", "RED", "WAIVED_BY_HUMAN"]
    },
    "decision_actor": { "enum": ["automation", "human"] },
    "recorded_at_utc": { "$ref": "#/$defs/utcTimestamp" },
    "implementation_revision": { "type": "string", "pattern": "^git:[0-9a-f]{40}$" },
    "test_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^TST-[A-Z0-9]+-[0-9]{3}$" }
    },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?:FR|NFR|SEC|OPS|STR)-[A-Z0-9]+-[0-9]{3}$" }
    },
    "adr_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/adrId" }
    },
    "fixture_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/fixtureRef" }
    },
    "environment": { "$ref": "#/$defs/environment" },
    "value_classification": { "enum": ["TARGET", "MEASURED"] },
    "evidence_artifacts": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/externalArtifact" }
    },
    "automated_report_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "operator_checklist_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "locked_decision_change_id": {
      "oneOf": [
        { "type": "string", "pattern": "^OD-[0-9]{4}-[0-9]{3}$" },
        { "type": "null" }
      ]
    },
    "prd_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "affected_adr_sha256": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/affectedAdrDigest" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "decision_actor": { "const": "automation" } },
        "required": ["decision_actor"]
      },
      "then": {
        "properties": {
          "gate_state": { "enum": ["UNRUN", "RUNNING", "RED"] }
        }
      }
    },
    {
      "if": {
        "properties": { "gate_state": { "const": "UNRUN" } },
        "required": ["gate_state"]
      },
      "then": {
        "properties": {
          "evidence_artifacts": { "maxItems": 0 },
          "automated_report_sha256": { "type": "null" },
          "operator_checklist_sha256": { "type": "null" },
          "locked_decision_change_id": { "type": "null" },
          "prd_sha256": { "type": "null" },
          "affected_adr_sha256": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "gate_state": { "const": "RUNNING" } },
        "required": ["gate_state"]
      },
      "then": {
        "properties": {
          "automated_report_sha256": { "type": "null" },
          "operator_checklist_sha256": { "type": "null" },
          "evidence_artifacts": {
            "contains": {
              "properties": { "artifact_role": { "const": "operator_attestation" } },
              "required": ["artifact_role"]
            },
            "minContains": 0,
            "maxContains": 0
          },
          "locked_decision_change_id": { "type": "null" },
          "prd_sha256": { "type": "null" },
          "affected_adr_sha256": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "gate_state": { "const": "RED" } },
        "required": ["gate_state"]
      },
      "then": {
        "properties": {
          "evidence_artifacts": { "minItems": 1 },
          "automated_report_sha256": { "$ref": "#/$defs/sha256" },
          "operator_checklist_sha256": { "type": "null" },
          "locked_decision_change_id": { "type": "null" },
          "prd_sha256": { "type": "null" },
          "affected_adr_sha256": { "maxItems": 0 }
        },
        "not": {
          "properties": {
            "evidence_artifacts": {
              "contains": {
                "properties": { "artifact_role": { "const": "operator_attestation" } },
                "required": ["artifact_role"]
              }
            }
          },
          "required": ["evidence_artifacts"]
        }
      }
    },
    {
      "if": {
        "properties": { "gate_state": { "const": "GREEN" } },
        "required": ["gate_state"]
      },
      "then": {
        "properties": {
          "decision_actor": { "const": "human" },
          "value_classification": { "const": "MEASURED" },
          "evidence_artifacts": {
            "minItems": 1,
            "contains": {
              "properties": {
                "artifact_kind": { "const": "ballot" },
                "artifact_role": { "const": "operator_attestation" }
              },
              "required": ["artifact_kind", "artifact_role"]
            },
            "minContains": 1,
            "maxContains": 1
          },
          "automated_report_sha256": { "$ref": "#/$defs/sha256" },
          "operator_checklist_sha256": { "$ref": "#/$defs/sha256" },
          "locked_decision_change_id": { "type": "null" },
          "prd_sha256": { "type": "null" },
          "affected_adr_sha256": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "gate_state": { "const": "WAIVED_BY_HUMAN" } },
        "required": ["gate_state"]
      },
      "then": {
        "properties": {
          "decision_actor": { "const": "human" },
          "evidence_artifacts": {
            "minItems": 1,
            "contains": {
              "properties": {
                "artifact_kind": { "const": "ballot" },
                "artifact_role": { "const": "operator_attestation" }
              },
              "required": ["artifact_kind", "artifact_role"]
            },
            "minContains": 1,
            "maxContains": 1
          },
          "operator_checklist_sha256": { "$ref": "#/$defs/sha256" },
          "locked_decision_change_id": { "type": "string", "pattern": "^OD-[0-9]{4}-[0-9]{3}$" },
          "prd_sha256": { "$ref": "#/$defs/sha256" },
          "affected_adr_sha256": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gateId": { "type": "string", "pattern": "^GATE-[0-9]{3}$" },
    "adrId": { "type": "string", "pattern": "^ADR-[0-9]{3}$" },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "safeLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._+():-]*$"
    },
    "fixtureRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "fixture_revision", "sha256"],
      "properties": {
        "fixture_id": { "type": "string", "pattern": "^FX-[A-Z0-9]+(?:-[A-Z0-9]+)+$" },
        "fixture_revision": { "type": "string", "pattern": "^rev-[0-9]{3}$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "capabilityFlags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["camera_permission", "arkit_world_tracking", "plane_detection", "lidar_required"],
      "properties": {
        "camera_permission": { "enum": ["not_tested", "granted", "denied", "not_applicable"] },
        "arkit_world_tracking": { "enum": ["not_tested", "pass", "fail", "not_applicable"] },
        "plane_detection": { "enum": ["not_tested", "pass", "fail", "not_applicable"] },
        "lidar_required": { "const": false }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_model",
        "os_version",
        "xcode_version",
        "runtime_tier",
        "capability_flags",
        "signing_result"
      ],
      "properties": {
        "device_model": {
          "oneOf": [
            { "type": "string", "pattern": "^iPhone [A-Za-z0-9][A-Za-z0-9 +.-]{0,31}$" },
            { "type": "null" }
          ]
        },
        "os_version": { "oneOf": [{ "$ref": "#/$defs/safeLabel" }, { "type": "null" }] },
        "xcode_version": { "oneOf": [{ "$ref": "#/$defs/safeLabel" }, { "type": "null" }] },
        "runtime_tier": { "$ref": "#/$defs/safeLabel" },
        "capability_flags": { "$ref": "#/$defs/capabilityFlags" },
        "signing_result": { "enum": ["not_tested", "pass", "fail", "not_applicable"] }
      },
      "description": "Sanitized environment facts only. Device UUIDs, team/account identifiers, user names, and filesystem paths have no representable field."
    },
    "externalArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opaque_artifact_id", "artifact_kind", "artifact_role", "sha256", "external_retention"],
      "properties": {
        "opaque_artifact_id": {
          "type": "string",
          "pattern": "^opaque-[a-z0-9][a-z0-9._-]{7,95}$"
        },
        "artifact_kind": {
          "enum": ["automated_report", "log", "trace", "screenshot", "video", "metric_output", "ballot"]
        },
        "artifact_role": {
          "enum": ["supporting_evidence", "operator_attestation"]
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "external_retention": { "const": true }
      },
      "allOf": [
        {
          "if": {
            "properties": { "artifact_role": { "const": "operator_attestation" } },
            "required": ["artifact_role"]
          },
          "then": {
            "properties": { "artifact_kind": { "const": "ballot" } }
          }
        }
      ],
      "description": "Opaque external reference only; absolute/relative paths and raw bytes are intentionally unrepresentable. operator_attestation identifies the one ballot that signs the non-circular unsigned-checklist payload and is excluded from the report-decision digest scope."
    },
    "affectedAdrDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adr_id", "sha256"],
      "properties": {
        "adr_id": { "$ref": "#/$defs/adrId" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
