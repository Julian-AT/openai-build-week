{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reroom:evidence-schema:operator-checklist:2",
  "title": "OperatorChecklistV2",
  "description": "Closed human approval or waiver checklist. automated_report_sha256 binds the automated result, report_decision_sha256 binds the non-circular final report decision payload, unsigned_checklist_sha256 identifies the exact payload presented for external attestation, and signature_sha256 identifies that externally retained ballot. Human identity, account, team, and signing material are intentionally absent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate_id",
    "decision",
    "decision_actor",
    "automated_report_sha256",
    "report_decision_sha256",
    "reviewed_at_utc",
    "checklist_items",
    "signature_scope",
    "unsigned_checklist_sha256",
    "signature_sha256"
  ],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "gate_id": { "type": "string", "pattern": "^GATE-[0-9]{3}$" },
    "decision": { "enum": ["GREEN", "WAIVED_BY_HUMAN"] },
    "decision_actor": { "const": "human" },
    "automated_report_sha256": { "$ref": "#/$defs/sha256" },
    "report_decision_sha256": { "$ref": "#/$defs/sha256" },
    "reviewed_at_utc": { "$ref": "#/$defs/utcTimestamp" },
    "checklist_items": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/checklistItem" }
    },
    "signature_scope": { "const": "RR-GATE-CHECKLIST-SHA256-1" },
    "unsigned_checklist_sha256": { "$ref": "#/$defs/sha256" },
    "signature_sha256": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "decision": { "const": "GREEN" } },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "checklist_items": {
            "items": { "$ref": "#/$defs/greenChecklistItem" },
            "allOf": [
              { "contains": { "properties": { "check_id": { "const": "automated_report_reviewed" } }, "required": ["check_id"] }, "minContains": 1 },
              { "contains": { "properties": { "check_id": { "const": "evidence_links_verified" } }, "required": ["check_id"] }, "minContains": 1 },
              { "contains": { "properties": { "check_id": { "const": "privacy_redaction_reviewed" } }, "required": ["check_id"] }, "minContains": 1 },
              { "contains": { "properties": { "check_id": { "const": "physical_or_human_observations_approved" } }, "required": ["check_id"] }, "minContains": 1 }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "checklist_items": {
            "items": { "$ref": "#/$defs/waiverChecklistItem" },
            "allOf": [
              { "contains": { "properties": { "check_id": { "const": "locked_decision_change_verified" } }, "required": ["check_id"] }, "minContains": 1 },
              { "contains": { "properties": { "check_id": { "const": "prd_update_verified" } }, "required": ["check_id"] }, "minContains": 1 },
              { "contains": { "properties": { "check_id": { "const": "affected_adr_updates_verified" } }, "required": ["check_id"] }, "minContains": 1 },
              { "contains": { "properties": { "check_id": { "const": "privacy_redaction_reviewed" } }, "required": ["check_id"] }, "minContains": 1 }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "checklistItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "outcome"],
      "properties": {
        "check_id": {
          "enum": [
            "automated_report_reviewed",
            "evidence_links_verified",
            "privacy_redaction_reviewed",
            "physical_or_human_observations_approved",
            "locked_decision_change_verified",
            "prd_update_verified",
            "affected_adr_updates_verified"
          ]
        },
        "outcome": { "const": "checked" }
      }
    },
    "greenChecklistItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "outcome"],
      "properties": {
        "check_id": {
          "enum": [
            "automated_report_reviewed",
            "evidence_links_verified",
            "privacy_redaction_reviewed",
            "physical_or_human_observations_approved"
          ]
        },
        "outcome": { "const": "checked" }
      }
    },
    "waiverChecklistItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "outcome"],
      "properties": {
        "check_id": {
          "enum": [
            "locked_decision_change_verified",
            "prd_update_verified",
            "affected_adr_updates_verified",
            "privacy_redaction_reviewed"
          ]
        },
        "outcome": { "const": "checked" }
      }
    }
  }
}
