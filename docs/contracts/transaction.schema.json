    "editProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection_version", "scene_id", "revision_branch_id", "world_frame_id", "world_frame_version", "object_edit_states", "placed_assets", "asset_support_relations"],
      "properties": {
        "projection_version": { "const": "RR-EDIT-PROJECTION-1" },
        "scene_id": { "type": "string", "pattern": "^scene_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "revision_branch_id": { "type": "string", "pattern": "^branch_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "world_frame_id": { "type": "string", "pattern": "^world_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "world_frame_version": { "type": "integer", "minimum": 1 },
        "object_edit_states": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/editProjectionObjectState" }, "description": "Complete object/edit_state projection, sorted lexicographically by object_id with unique IDs." },
        "placed_assets": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/editProjectionPlacedAsset" }, "description": "Complete placed_assets projection, sorted lexicographically by placed_asset_id with unique IDs." },
        "asset_support_relations": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/editProjectionAssetSupportRelation" }, "description": "Complete support_relations subset whose subject_id is assetinst_, sorted lexicographically by relation_id with unique IDs." }
      },
      "description": "Exact edit-managed projection of CON-003. It excludes session/schema/authority/revision envelopes, surfaces, non-edit object evidence/readiness, non-asset support relations, edit_history, and updated_at_utc."
    },
    "restoreRebaseDerivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "source_transaction_id", "source_inverse_before_projection_sha256", "source_inverse_after_projection_sha256", "touched_object_ids", "touched_placed_asset_ids", "touched_asset_support_relation_ids"],
      "properties": {
        "rule": { "const": "RR-RESTORE-REBASE-1" },
        "source_transaction_id": { "type": "string", "pattern": "^tx_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "source_inverse_before_projection_sha256": { "$ref": "#/$defs/sha256" },
        "source_inverse_after_projection_sha256": { "$ref": "#/$defs/sha256" },
        "touched_object_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^object_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }, "description": "Lexicographically sorted IDs whose edit-state values differ between the persisted source inverse before/after projections." },
        "touched_placed_asset_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^assetinst_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }, "description": "Lexicographically sorted placed-asset IDs whose presence/value differs in the persisted source inverse." },
        "touched_asset_support_relation_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^support_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }, "description": "Lexicographically sorted asset-support IDs whose presence/value differs in the persisted source inverse." }
      },
      "description": "Derive the restore after-projection from the current complete projection. First require every touched ID's current value/presence to equal the persisted source inverse before-value/presence; unexpected touched-entity drift rejects. Then, for exactly the touched IDs, apply the persisted source inverse after-value (or remove when absent); preserve current values/membership for every untouched or newly tracked ID. Validate touched sets against the source transaction's exact ordered operations and inverse diff."
    },
    "editProjectionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captured_scene_revision", "projection_origin", "derivation", "projection_sha256_algorithm", "projection_sha256_scope", "projection_sha256", "projection"],
      "properties": {
        "captured_scene_revision": { "type": "integer", "minimum": 0, "description": "Provenance outside the projection digest; applying projection content never copies this value into the output SceneState envelope." },
        "projection_origin": { "enum": ["captured_exact", "restore_rebase"] },
        "derivation": { "oneOf": [{ "$ref": "#/$defs/restoreRebaseDerivation" }, { "type": "null" }] },
        "projection_sha256_algorithm": { "const": "RR-JCS-SHA256-1" },
        "projection_sha256_scope": { "const": "entire_rr_edit_projection_1" },
        "projection_sha256": { "$ref": "#/$defs/sha256" },
        "projection": { "$ref": "#/$defs/editProjection" }
      },
      "allOf": [
        {
          "if": { "properties": { "projection_origin": { "const": "captured_exact" } }, "required": ["projection_origin"] },
          "then": { "properties": { "derivation": { "type": "null" } } }
        },
        {
          "if": { "properties": { "projection_origin": { "const": "restore_rebase" } }, "required": ["projection_origin"] },
          "then": { "properties": { "derivation": { "$ref": "#/$defs/restoreRebaseDerivation" } } }
        }
      ],
      "description": "Offline-complete inverse/rebase content. Hash exactly the JCS projection member. A restore proposal rebases only persisted touched edit IDs onto the current complete projection, then creates a fresh monotonic SceneState envelope and appends history."
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "entity_id", "before", "after", "required_artifact_refs"],
          "properties": {
            "kind": { "const": "create_asset_instance" },
            "entity_id": { "type": "string", "pattern": "^assetinst_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
            "before": { "type": "null" },
            "after": { "$ref": "#/$defs/assetInstanceSnapshot" },
            "required_artifact_refs": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/artifactRef" }, "contains": { "properties": { "artifact_type": { "const": "asset_manifest" } }, "required": ["artifact_type"] }, "minContains": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "entity_id", "before", "after"],
          "properties": {
            "kind": { "const": "set_asset_transform" },
            "entity_id": { "type": "string", "pattern": "^assetinst_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
            "before": { "$ref": "#/$defs/matrix4" },
            "after": { "$ref": "#/$defs/matrix4" },
            "required_artifact_refs": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/artifactRef" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "entity_id", "before", "after"],
          "properties": {
            "kind": { "const": "set_object_visibility" },
            "entity_id": { "type": "string", "pattern": "^object_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
            "before": { "$ref": "#/$defs/visibilitySnapshot" },
            "after": { "$ref": "#/$defs/visibilitySnapshot" },
            "required_artifact_refs": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/artifactRef" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "entity_id", "before", "after", "required_artifact_refs"],
          "properties": {
            "kind": { "const": "set_reveal_bundle" },
            "entity_id": { "type": "string", "pattern": "^object_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
            "before": { "oneOf": [{ "$ref": "#/$defs/revealArtifactSnapshot" }, { "type": "null" }] },
            "after": { "oneOf": [{ "$ref": "#/$defs/revealArtifactSnapshot" }, { "type": "null" }] },
            "required_artifact_refs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": { "$ref": "#/$defs/artifactRef" },
              "contains": { "type": "object", "properties": { "artifact_type": { "const": "reveal_bundle" } }, "required": ["artifact_type"] },
              "minContains": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "entity_id", "before", "after", "required_artifact_refs"],
          "properties": {
            "kind": { "const": "restore_snapshot" },
            "entity_id": { "type": "string", "pattern": "^scene_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
            "before": { "$ref": "#/$defs/editProjectionSnapshot" },
            "after": { "$ref": "#/$defs/editProjectionSnapshot" },
            "required_artifact_refs": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/artifactRef" }, "description": "Exact locally durable artifact-reference union needed to render after.projection. Deterministic validation rejects a missing, extra, stale, wrong-branch/world, or digest-mismatched reference; an empty union is represented by []." }
          }
        }
      ]
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "checks", "validator_version", "input_sha256_algorithm", "input_sha256_scope", "input_sha256"],
      "properties": {
        "state": { "enum": ["not_run", "passed", "failed"] },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check_id", "result", "measured", "threshold"],
            "properties": {
              "check_id": { "enum": ["scene_revision", "target_exists", "capability_ready", "support", "collision_proxy", "room_boundary_proxy", "walkway_proxy", "asset_license", "artifact_integrity", "view_envelope", "snapshot_integrity", "compensation_eligibility"] },
              "result": { "enum": ["pass", "fail", "not_applicable"] },
              "measured": { "oneOf": [{ "$ref": "#/$defs/finiteNumber" }, { "type": "string" }, { "type": "boolean" }, { "type": "null" }] },
              "threshold": { "oneOf": [{ "$ref": "#/$defs/finiteNumber" }, { "type": "string" }, { "type": "boolean" }, { "type": "null" }] }
            }
          }
        },
        "validator_version": { "type": "string", "minLength": 1 },
        "input_sha256_algorithm": { "const": "RR-JCS-SHA256-1" },
        "input_sha256_scope": { "const": "request_fingerprint_object_plus_validation_checks_without_validation_results" },
        "input_sha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "not_run" } }, "required": ["state"] },
          "then": { "properties": { "checks": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "state": { "const": "passed" } }, "required": ["state"] },
          "then": {
            "properties": {
              "checks": {
                "minItems": 1,
                "items": {
                  "properties": { "result": { "enum": ["pass", "not_applicable"] } },
                  "required": ["result"]
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "failed" } }, "required": ["state"] },
          "then": {
            "properties": {
              "checks": {
                "minItems": 1,
                "contains": { "properties": { "result": { "const": "fail" } }, "required": ["result"] },
                "minContains": 1
              }
            }
          }
        }
      ]
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preview_id", "base_scene_revision", "expires_at_utc", "artifact_refs"],
      "properties": {
        "preview_id": { "type": "string", "pattern": "^preview_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "base_scene_revision": { "type": "integer", "minimum": 0, "description": "Must equal transaction base; preview never advances scene_revision." },
        "expires_at_utc": { "type": "string", "format": "date-time" },
        "artifact_refs": { "type": "array", "items": { "$ref": "#/$defs/artifactRef" } }
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_id", "revision_branch_id", "compare_and_swap_base_revision", "committed_scene_revision", "confirmation", "committed_at_utc", "local_durable_before_visible_ack", "result_sha256_algorithm", "result_sha256_scope", "result_sha256"],
      "properties": {
        "authority_id": { "type": "string", "pattern": "^(device|gateway)_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "description": "Must equal revision_authority.authority_id; deterministic validation enforces equality." },
        "revision_branch_id": { "type": "string", "pattern": "^branch_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "description": "Must equal revision_authority.revision_branch_id; deterministic validation enforces equality." },
        "compare_and_swap_base_revision": { "type": "integer", "minimum": 0 },
        "committed_scene_revision": { "type": "integer", "minimum": 1, "description": "Must equal compare_and_swap_base_revision + 1." },
        "confirmation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "actor_id", "source", "preview_id", "confirmation_event_id", "confirmed_at_utc"],
          "properties": {
            "kind": { "const": "explicit_user_confirmation" },
            "actor_id": { "type": "string", "pattern": "^user_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "description": "Session-scoped pseudonymous user identity; never a model/service identity." },
            "source": { "enum": ["native_ui", "web_b0_ui"] },
            "preview_id": { "type": "string", "pattern": "^preview_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "description": "Must equal transaction preview.preview_id; deterministic validation enforces equality." },
            "confirmation_event_id": { "type": "string", "pattern": "^event_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
            "confirmed_at_utc": { "type": "string", "format": "date-time" }
          }
        },
        "committed_at_utc": { "type": "string", "format": "date-time" },
        "local_durable_before_visible_ack": { "const": true },
        "result_sha256_algorithm": { "const": "RR-JCS-SHA256-1" },
        "result_sha256_scope": { "const": "commit_object_with_result_sha256_member_omitted" },
        "result_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "enum": ["stale_scene_revision", "idempotency_conflict", "revision_branch_conflict", "authority_conflict", "target_lost", "capability_not_ready", "validation_failed", "artifact_missing", "tracking_lost", "network_unavailable", "unauthorized", "invalid_contract", "internal"] },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "last_known_gateway_revision", "resolution", "automatic_merge_permitted"],
      "properties": {
        "state": { "enum": ["not_required", "pending", "resolved", "manual_required"] },
