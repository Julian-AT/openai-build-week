        "source_transaction_id": { "type": "string", "pattern": "^tx_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }
      }
    },
    "editProjectionAssetSupportRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_id", "subject_id", "surface_id", "confidence", "method"],
      "properties": {
        "relation_id": { "type": "string", "pattern": "^support_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "subject_id": { "type": "string", "pattern": "^assetinst_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "surface_id": { "type": "string", "pattern": "^surface_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "confidence": { "$ref": "#/$defs/finiteNumber", "minimum": 0, "maximum": 1 },
