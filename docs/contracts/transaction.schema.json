        "asset_id": { "type": "string", "pattern": "^asset_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "manifest_artifact_ref": { "$ref": "#/$defs/assetManifestArtifactRef" },
        "world_from_asset": { "$ref": "#/$defs/matrix4" },
