{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reroom:schema:transaction:1",
  "title": "ReRoom Transaction v1",
  "description": "Deterministic validate/preview/commit contract. Restore is a new compensating transaction. Each revision branch has exactly one authority; Mode A uses the native device and B0 may use a distinct gateway-owned replay branch. Canonical lifecycle is independent of synchronization state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transaction_id", "idempotency_key", "request_fingerprint_algorithm", "request_fingerprint_scope", "request_fingerprint_sha256", "session_id", "revision_authority", "base_scene_revision", "target_context", "intent", "proposed_operations", "validation", "canonical_state", "sync_state", "created_at_utc"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "transaction_id": { "type": "string", "pattern": "^tx_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "idempotency_key": { "type": "string", "pattern": "^txidem_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "request_fingerprint_algorithm": { "const": "RR-JCS-SHA256-1" },
    "request_fingerprint_scope": { "const": "schema_version_session_id_revision_authority_base_scene_revision_target_context_intent_proposed_operations", "description": "JCS object containing exactly these top-level members and no transaction/idempotency IDs, timestamps, lifecycle, validation, preview, commit, inverse, sync, failure, or reconciliation results." },
    "request_fingerprint_sha256": { "$ref": "#/$defs/sha256" },
    "session_id": { "type": "string", "pattern": "^session_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "revision_authority": { "$ref": "#/$defs/revisionAuthority" },
    "base_scene_revision": { "type": "integer", "minimum": 0 },
    "target_context": { "$ref": "#/$defs/targetContext" },
    "intent": { "$ref": "#/$defs/intent" },
    "proposed_operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/operation" } },
    "validation": { "$ref": "#/$defs/validation" },
    "preview": { "$ref": "#/$defs/preview" },
    "commit": { "$ref": "#/$defs/commit" },
    "inverse_operations": { "type": "array", "items": { "$ref": "#/$defs/operation" } },
    "local_undo_token": { "type": "string", "pattern": "^undo_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "compensates_transaction_id": { "type": "string", "pattern": "^tx_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "canonical_state": { "enum": ["draft", "validated", "previewed", "committed", "rejected", "cancelled"] },
    "sync_state": { "enum": ["local_only", "pending_sync", "synced", "conflict", "sync_failed"] },
    "failure_reasons": { "type": "array", "items": { "$ref": "#/$defs/failure" } },
    "reconciliation": { "$ref": "#/$defs/reconciliation" },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "updated_at_utc": { "type": ["string", "null"], "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "canonical_state": { "const": "committed" } }, "required": ["canonical_state"] },
      "then": {
        "required": ["preview", "commit", "inverse_operations", "local_undo_token"],
        "properties": {
          "validation": {
            "type": "object",
            "required": ["state"],
            "properties": {
              "state": { "const": "passed" },
              "checks": {
                "allOf": [
                  { "contains": { "properties": { "check_id": { "const": "scene_revision" }, "result": { "const": "pass" } }, "required": ["check_id", "result"] }, "minContains": 1 },
                  { "contains": { "properties": { "check_id": { "const": "artifact_integrity" }, "result": { "const": "pass" } }, "required": ["check_id", "result"] }, "minContains": 1 }
                ]
              }
            }
          },
          "inverse_operations": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "properties": { "kind": { "const": "restore_snapshot" }, "before": { "properties": { "projection_origin": { "const": "captured_exact" } }, "required": ["projection_origin"] }, "after": { "properties": { "projection_origin": { "const": "captured_exact" } }, "required": ["projection_origin"] } }, "required": ["kind", "before", "after"] } },
          "local_undo_token": { "type": "string", "pattern": "^undo_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }
        }
      }
    },
    {
      "if": { "properties": { "intent": { "properties": { "operation": { "const": "restore" } }, "required": ["operation"] } } },
      "then": {
        "required": ["compensates_transaction_id"],
        "properties": {
          "compensates_transaction_id": { "type": "string", "pattern": "^tx_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }
        }
      },
      "else": { "not": { "required": ["compensates_transaction_id"] } }
    },
    {
      "if": {
        "properties": { "canonical_state": { "enum": ["validated", "previewed", "committed"] } },
        "required": ["canonical_state"]
      },
      "then": {
        "properties": {
          "validation": {
            "type": "object",
            "required": ["state"],
            "properties": { "state": { "const": "passed" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "canonical_state": { "const": "previewed" } }, "required": ["canonical_state"] },
      "then": {
        "required": ["preview"],
        "not": { "anyOf": [{ "required": ["commit"] }, { "required": ["inverse_operations"] }, { "required": ["local_undo_token"] }] }
      }
    },
    {
      "if": { "properties": { "canonical_state": { "const": "draft" } }, "required": ["canonical_state"] },
      "then": {
        "properties": { "validation": { "properties": { "state": { "const": "not_run" } }, "required": ["state"] } },
        "not": { "anyOf": [{ "required": ["preview"] }, { "required": ["commit"] }, { "required": ["inverse_operations"] }, { "required": ["local_undo_token"] }] }
      }
    },
    {
      "if": { "properties": { "canonical_state": { "const": "validated" } }, "required": ["canonical_state"] },
      "then": {
        "not": { "anyOf": [{ "required": ["preview"] }, { "required": ["commit"] }, { "required": ["inverse_operations"] }, { "required": ["local_undo_token"] }] }
      }
    },
    {
      "if": { "properties": { "canonical_state": { "const": "rejected" } }, "required": ["canonical_state"] },
      "then": {
        "required": ["failure_reasons"],
        "properties": {
          "validation": { "properties": { "state": { "const": "failed" } }, "required": ["state"] },
          "failure_reasons": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/failure" } }
        },
        "not": { "anyOf": [{ "required": ["preview"] }, { "required": ["commit"] }, { "required": ["inverse_operations"] }, { "required": ["local_undo_token"] }] }
      }
    },
    {
      "if": { "properties": { "canonical_state": { "const": "cancelled" } }, "required": ["canonical_state"] },
      "then": {
        "not": { "anyOf": [{ "required": ["commit"] }, { "required": ["inverse_operations"] }, { "required": ["local_undo_token"] }] }
      }
    },
    {
      "if": { "properties": { "intent": { "properties": { "operation": { "const": "place" } }, "required": ["operation"] } }, "required": ["intent"] },
      "then": {
        "properties": {
          "proposed_operations": { "minItems": 1, "maxItems": 1, "prefixItems": [{ "properties": { "kind": { "const": "create_asset_instance" } }, "required": ["kind"] }] }
        }
      }
    },
    {
      "if": { "properties": { "intent": { "properties": { "operation": { "const": "replace" } }, "required": ["operation"] } }, "required": ["intent"] },
      "then": {
        "properties": {
          "proposed_operations": {
            "oneOf": [
              { "minItems": 2, "maxItems": 2, "prefixItems": [{ "properties": { "kind": { "const": "set_object_visibility" }, "before": { "properties": { "visible": { "const": true } }, "required": ["visible"] }, "after": { "properties": { "visible": { "const": false } }, "required": ["visible"] } }, "required": ["kind", "before", "after"] }, { "properties": { "kind": { "const": "create_asset_instance" } }, "required": ["kind"] }] },
              { "minItems": 3, "maxItems": 3, "prefixItems": [{ "properties": { "kind": { "const": "set_reveal_bundle" }, "after": { "$ref": "#/$defs/revealArtifactSnapshot" } }, "required": ["kind", "after"] }, { "properties": { "kind": { "const": "set_object_visibility" }, "before": { "properties": { "visible": { "const": true } }, "required": ["visible"] }, "after": { "properties": { "visible": { "const": false } }, "required": ["visible"] } }, "required": ["kind", "before", "after"] }, { "properties": { "kind": { "const": "create_asset_instance" } }, "required": ["kind"] }] }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "intent": { "properties": { "operation": { "const": "remove" } }, "required": ["operation"] } }, "required": ["intent"] },
      "then": {
        "properties": {
          "proposed_operations": { "minItems": 2, "maxItems": 2, "prefixItems": [{ "properties": { "kind": { "const": "set_reveal_bundle" }, "after": { "$ref": "#/$defs/revealArtifactSnapshot" } }, "required": ["kind", "after"] }, { "properties": { "kind": { "const": "set_object_visibility" }, "before": { "properties": { "visible": { "const": true } }, "required": ["visible"] }, "after": { "properties": { "visible": { "const": false } }, "required": ["visible"] } }, "required": ["kind", "before", "after"] }] }
        }
      }
    },
    {
      "if": { "properties": { "intent": { "properties": { "operation": { "const": "restore" } }, "required": ["operation"] } }, "required": ["intent"] },
      "then": {
        "properties": {
          "proposed_operations": { "minItems": 1, "maxItems": 1, "prefixItems": [{ "properties": { "kind": { "const": "restore_snapshot" }, "before": { "properties": { "projection_origin": { "const": "captured_exact" } }, "required": ["projection_origin"] }, "after": { "properties": { "projection_origin": { "const": "restore_rebase" } }, "required": ["projection_origin"] } }, "required": ["kind", "before", "after"] }] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "canonical_state": { "enum": ["validated", "previewed", "committed"] },
          "intent": { "properties": { "operation": { "const": "place" } }, "required": ["operation"] }
        },
        "required": ["canonical_state", "intent"]
      },
      "then": {
        "properties": {
          "validation": {
            "properties": {
              "checks": {
                "allOf": [
                  { "contains": { "properties": { "check_id": { "const": "scene_revision" }, "result": { "const": "pass" } }, "required": ["check_id", "result"] }, "minContains": 1 },
                  { "contains": { "properties": { "check_id": { "const": "artifact_integrity" }, "result": { "const": "pass" } }, "required": ["check_id", "result"] }, "minContains": 1 },
                  { "contains": { "properties": { "check_id": { "const": "support" }, "result": { "const": "pass" } }, "required": ["check_id", "result"] }, "minContains": 1 },
                  { "contains": { "properties": { "check_id": { "const": "collision_proxy" }, "result": { "const": "pass" } }, "required": ["check_id", "result"] }, "minContains": 1 },
                  { "contains": { "properties": { "check_id": { "const": "asset_license" }, "result": { "const": "pass" } }, "required": ["check_id", "result"] }, "minContains": 1 }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "canonical_state": { "enum": ["validated", "previewed", "committed"] },
          "intent": { "properties": { "operation": { "const": "replace" } }, "required": ["operation"] }
        },
        "required": ["canonical_state", "intent"]
      },
      "then": {
        "properties": {
          "validation": {
            "properties": {
              "checks": {
                "allOf": [
                  { "contains": { "properties": { "check_id": { "const": "scene_revision" }, "result": { "const": "pass" } }, "required": ["check_id", "result"] }, "minContains": 1 },
                  { "contains": { "properties": { "check_id": { "const": "artifact_integrity" }, "result": { "const": "pass" } }, "required": ["check_id", "result"] }, "minContains": 1 },
                  { "contains": { "properties": { "check_id": { "const": "target_exists" }, "result": { "const": "pass" } }, "required": ["check_id", "result"] }, "minContains": 1 },
                  { "contains": { "properties": { "check_id": { "const": "capability_ready" }, "result": { "const": "pass" } }, "required": ["check_id", "result"] }, "minContains": 1 },
                  { "contains": { "properties": { "check_id": { "const": "support" }, "result": { "const": "pass" } }, "required": ["check_id", "result"] }, "minContains": 1 },
                  { "contains": { "properties": { "check_id": { "const": "collision_proxy" }, "result": { "const": "pass" } }, "required": ["check_id", "result"] }, "minContains": 1 },
                  { "contains": { "properties": { "check_id": { "const": "asset_license" }, "result": { "const": "pass" } }, "required": ["check_id", "result"] }, "minContains": 1 }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "canonical_state": { "enum": ["validated", "previewed", "committed"] },
          "intent": { "properties": { "operation": { "const": "remove" } }, "required": ["operation"] }
        },
        "required": ["canonical_state", "intent"]
      },
      "then": {
        "properties": {
          "validation": {
            "properties": {
              "checks": {
                "allOf": [
                  { "contains": { "properties": { "check_id": { "const": "scene_revision" }, "result": { "const": "pass" } }, "required": ["check_id", "result"] }, "minContains": 1 },
                  { "contains": { "properties": { "check_id": { "const": "artifact_integrity" }, "result": { "const": "pass" } }, "required": ["check_id", "result"] }, "minContains": 1 },
                  { "contains": { "properties": { "check_id": { "const": "target_exists" }, "result": { "const": "pass" } }, "required": ["check_id", "result"] }, "minContains": 1 },
                  { "contains": { "properties": { "check_id": { "const": "capability_ready" }, "result": { "const": "pass" } }, "required": ["check_id", "result"] }, "minContains": 1 },
                  { "contains": { "properties": { "check_id": { "const": "view_envelope" }, "result": { "const": "pass" } }, "required": ["check_id", "result"] }, "minContains": 1 }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "canonical_state": { "enum": ["validated", "previewed", "committed"] },
          "intent": { "properties": { "operation": { "const": "restore" } }, "required": ["operation"] }
        },
        "required": ["canonical_state", "intent"]
      },
      "then": {
        "properties": {
          "validation": {
            "properties": {
              "checks": {
                "allOf": [
                  { "contains": { "properties": { "check_id": { "const": "scene_revision" }, "result": { "const": "pass" } }, "required": ["check_id", "result"] }, "minContains": 1 },
                  { "contains": { "properties": { "check_id": { "const": "artifact_integrity" }, "result": { "const": "pass" } }, "required": ["check_id", "result"] }, "minContains": 1 },
                  { "contains": { "properties": { "check_id": { "const": "snapshot_integrity" }, "result": { "const": "pass" } }, "required": ["check_id", "result"] }, "minContains": 1 },
                  { "contains": { "properties": { "check_id": { "const": "compensation_eligibility" }, "result": { "const": "pass" } }, "required": ["check_id", "result"] }, "minContains": 1 }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "canonical_state": { "enum": ["validated", "previewed", "committed"] },
          "intent": { "properties": { "operation": { "const": "replace" } }, "required": ["operation"] },
          "proposed_operations": { "contains": { "properties": { "kind": { "const": "set_reveal_bundle" } }, "required": ["kind"] } }
        },
        "required": ["canonical_state", "intent", "proposed_operations"]
      },
      "then": {
        "properties": {
          "validation": {
            "properties": {
              "checks": { "contains": { "properties": { "check_id": { "const": "view_envelope" }, "result": { "const": "pass" } }, "required": ["check_id", "result"] }, "minContains": 1 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "finiteNumber": {
      "type": "number",
      "minimum": -3.4028234663852886e38,
      "maximum": 3.4028234663852886e38,
      "description": "Finite binary32-range JSON number; deterministic validation applies RR-FLOAT-1 conversion and semantic checks."
    },
    "revisionAuthority": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "authority_id", "revision_branch_id"],
          "properties": {
            "kind": { "const": "native_device" },
            "authority_id": { "type": "string", "pattern": "^device_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
            "revision_branch_id": { "type": "string", "pattern": "^branch_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "authority_id", "revision_branch_id"],
          "properties": {
            "kind": { "const": "replay_gateway" },
            "authority_id": { "type": "string", "pattern": "^gateway_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
            "revision_branch_id": { "type": "string", "pattern": "^branch_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }
          }
        }
      ]
    },
    "matrix4": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "scalar_type", "math_convention", "units", "values"],
      "properties": {
        "layout": { "const": "row_major" },
        "scalar_type": { "const": "float32" },
        "math_convention": { "const": "column_vector" },
        "units": { "const": "meters" },
        "values": { "type": "array", "minItems": 16, "maxItems": 16, "items": { "$ref": "#/$defs/finiteNumber" } }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_type", "artifact_revision", "sha256"],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^artifact_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "artifact_type": { "enum": ["mask_volume", "surface_mesh", "obb", "occluder_chunk", "reveal_bundle", "asset_manifest", "world_frame_correction"] },
        "artifact_revision": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "assetManifestArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_type", "artifact_revision", "sha256"],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^artifact_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "artifact_type": { "const": "asset_manifest" },
        "artifact_revision": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "targetContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captured_at_frame_id", "captured_scene_revision", "world_frame_id", "world_frame_version", "camera_pose", "screen_point_encoded_pixels", "candidate_object_ids", "selected_object_id", "artifact_refs"],
      "properties": {
        "captured_at_frame_id": { "type": "string", "pattern": "^frame_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "captured_scene_revision": { "type": "integer", "minimum": 0 },
        "world_frame_id": { "type": "string", "pattern": "^world_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "world_frame_version": { "type": "integer", "minimum": 1 },
        "camera_pose": { "$ref": "#/$defs/matrix4" },
        "screen_point_encoded_pixels": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/finiteNumber" } },
        "candidate_object_ids": { "type": "array", "items": { "type": "string", "pattern": "^object_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" } },
        "selected_object_id": { "type": ["string", "null"], "pattern": "^object_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "artifact_refs": { "type": "array", "items": { "$ref": "#/$defs/artifactRef" } }
      }
    },
    "assetIntentArguments": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 2,
      "properties": {
        "asset_id": { "type": "string", "pattern": "^asset_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "catalog_query": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "anyOf": [
        { "required": ["asset_id"] },
        { "required": ["catalog_query"] }
      ]
    },
    "emptyIntentArguments": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "typedConstraint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "enum": ["style_tag", "color_tag"] },
            "value": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "enum": ["preserve_walkway", "support_required"] },
            "value": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "max_footprint_m2" },
            "value": { "$ref": "#/$defs/finiteNumber", "exclusiveMinimum": 0, "maximum": 20 }
          }
        }
