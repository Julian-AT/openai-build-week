{
  "mode": "interactive",
  "runtime": "codex",
  "model_profile": "quality",
  "models": {
    "planning": "opus",
    "discuss": "opus",
    "research": "opus",
    "execution": "opus",
    "verification": "opus",
    "completion": "opus"
  },
  "granularity": "fine",
