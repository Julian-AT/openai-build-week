    "ui_phase": true,
    "ui_review": true,
    "ui_safety_gate": true,
    "context_coverage_gate": true,
    "context_guard_mode": "auto",
    "security_enforcement": true,
    "security_asvs_level": 2,
    "security_block_on": "medium"
  },
  "plan_review": {
    "source_grounding": true,
    "source_grounding_authority": "grep"
  },
