{
  "mode": "interactive",
  "runtime": "codex",
  "model_profile": "balanced",
  "models": {
    "planning": "opus",
    "discuss": "opus",
    "research": "opus",
    "execution": "sonnet",
    "verification": "opus",
    "completion": "sonnet"
  },
  "granularity": "standard",
  "granularities": {
    "planning": "fine",
    "discuss": "fine",
    "research": "fine",
    "execution": "standard",
    "verification": "standard",
    "completion": "fine"
  },
  "parallelization": true,
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "auto_advance": false,
    "nyquist_validation": true,
    "post_planning_gaps": true,
    "node_repair": true,
    "node_repair_budget": 2,
    "human_verify_mode": "end-of-phase",
    "research_before_questions": false,
    "discuss_mode": "assumptions",
    "max_discuss_passes": 2,
    "skip_discuss": false,
    "use_worktrees": false,
    "code_review": true,
    "code_review_depth": "standard",
    "ui_phase": true,
    "ui_review": true,
    "ui_safety_gate": true,
    "context_coverage_gate": true,
    "context_guard_mode": "warn",
    "security_enforcement": true,
    "security_asvs_level": 1,
    "security_block_on": "high"
  },
  "plan_review": {
    "source_grounding": true,
    "source_grounding_authority": "grep"
  },
  "hooks": {
    "context_warnings": true
  }
}
