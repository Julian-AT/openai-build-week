{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reroom:verification:transaction-trace-result:1",
  "title": "ReRoom Transaction Trace Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_format", "fixture", "runtime", "implementation", "operation_order",
    "operation_delta_order", "proposals", "safety", "cases", "fingerprints",
    "projections", "revisions", "receipts", "retry", "restore", "divergence", "traces"
  ],
  "properties": {
    "trace_format": {"type": "string", "minLength": 1, "maxLength": 64},
    "fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["fixture_id", "fixture_revision", "manifest_sha256"],
      "properties": {
        "fixture_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "fixture_revision": {"type": "string", "minLength": 1, "maxLength": 32},
        "manifest_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["language", "name", "version"],
      "properties": {
        "language": {"type": "string", "minLength": 1, "maxLength": 32},
        "name": {"type": "string", "minLength": 1, "maxLength": 64},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "implementation": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_revision", "source_files", "source_tree_sha256"],
      "properties": {
        "repository_revision": {"type": "string", "pattern": "^git:[0-9a-f]{40}$"},
        "source_files": {
          "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": {"$ref": "#/$defs/relativePath"}
        },
        "source_tree_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "operation_order": {
      "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": {"$ref": "#/$defs/operation"}
    },
    "operation_delta_order": {
      "type": "object", "additionalProperties": false,
      "required": ["place", "replace", "remove", "restore"],
      "properties": {
        "place": {"$ref": "#/$defs/deltaKinds"},
        "replace": {"$ref": "#/$defs/deltaKinds"},
        "remove": {"$ref": "#/$defs/deltaKinds"},
        "restore": {"$ref": "#/$defs/deltaKinds"}
      }
    },
    "proposals": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": {"$ref": "#/$defs/proposal"}
    },
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": ["injection_case_id", "injection_mutation_count", "injection_rejection", "injection_verdict"],
      "properties": {
        "injection_case_id": {"$ref": "#/$defs/shortString"},
        "injection_mutation_count": {"type": "integer", "minimum": 0, "maximum": 16},
        "injection_rejection": {"$ref": "#/$defs/shortString"},
        "injection_verdict": {"enum": ["accept", "reject"]}
      }
    },
    "cases": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "outcome", "rejection"],
        "properties": {
          "case_id": {"$ref": "#/$defs/shortString"},
          "outcome": {"$ref": "#/$defs/shortString"},
          "rejection": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/shortString"}]}
        }
      }
    },
    "fingerprints": {
      "type": "object", "additionalProperties": false,
      "required": ["place_request_sha256", "restore_request_sha256"],
      "properties": {
        "place_request_sha256": {"$ref": "#/$defs/digest"},
        "restore_request_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "projections": {
      "type": "object", "additionalProperties": false,
      "required": ["base_sha256", "placed_sha256", "restored_sha256", "touched_asset_support_relation_ids", "touched_object_ids", "touched_placed_asset_ids"],
      "properties": {
        "base_sha256": {"$ref": "#/$defs/digest"},
        "placed_sha256": {"$ref": "#/$defs/digest"},
        "restored_sha256": {"$ref": "#/$defs/digest"},
        "touched_asset_support_relation_ids": {"$ref": "#/$defs/idList"},
        "touched_object_ids": {"$ref": "#/$defs/idList"},
        "touched_placed_asset_ids": {"$ref": "#/$defs/idList"}
      }
    },
    "revisions": {
      "type": "object", "additionalProperties": false,
      "required": ["place_scene_revision", "preview_scene_revision", "restore_scene_revision"],
      "properties": {
        "place_scene_revision": {"$ref": "#/$defs/revision"},
        "preview_scene_revision": {"$ref": "#/$defs/revision"},
        "restore_scene_revision": {"$ref": "#/$defs/revision"}
      }
    },
    "receipts": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["committed_scene_revision", "request_fingerprint_sha256", "result_sha256", "transaction_id"],
        "properties": {
          "committed_scene_revision": {"$ref": "#/$defs/revision"},
          "request_fingerprint_sha256": {"$ref": "#/$defs/digest"},
          "result_sha256": {"$ref": "#/$defs/digest"},
          "transaction_id": {"$ref": "#/$defs/shortString"}
        }
      }
    },
    "retry": {
      "type": "object", "additionalProperties": false,
      "required": ["duplicate_mutation_count", "same_key_changed_fingerprint", "same_key_same_fingerprint"],
      "properties": {
        "duplicate_mutation_count": {"type": "integer", "minimum": 0, "maximum": 16},
        "same_key_changed_fingerprint": {"$ref": "#/$defs/shortString"},
        "same_key_same_fingerprint": {"$ref": "#/$defs/shortString"}
      }
    },
    "restore": {
      "type": "object", "additionalProperties": false,
      "required": ["compensates_transaction_id", "network_reads", "preserved_unaffected_state", "source_transaction_immutable"],
      "properties": {
        "compensates_transaction_id": {"$ref": "#/$defs/shortString"},
        "network_reads": {"type": "integer", "minimum": 0, "maximum": 16},
        "preserved_unaffected_state": {"type": "boolean"},
        "source_transaction_immutable": {"type": "boolean"}
      }
    },
    "divergence": {
      "type": "object", "additionalProperties": false,
      "required": ["automatic_merge_permitted", "histories_preserved", "mutation_frozen", "resolution"],
      "properties": {
        "automatic_merge_permitted": {"type": "boolean"},
        "histories_preserved": {"type": "integer", "minimum": 0, "maximum": 16},
        "mutation_frozen": {"type": "boolean"},
        "resolution": {"$ref": "#/$defs/shortString"}
      }
    },
    "traces": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {"$ref": "#/$defs/trace"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"},
    "shortString": {"type": "string", "minLength": 1, "maxLength": 128},
    "operation": {"enum": ["place", "replace", "remove", "restore"]},
    "revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "deltaKinds": {
      "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": {"enum": ["create_asset_instance", "set_object_visibility", "set_reveal_bundle", "restore_snapshot"]}
    },
    "idList": {
      "type": "array", "minItems": 0, "maxItems": 16, "uniqueItems": true,
      "items": {"$ref": "#/$defs/shortString"}
    },
    "proposal": {
      "type": "object", "additionalProperties": false,
      "required": ["authority", "blocker", "operation", "preauthorized_commit", "preauthorized_confirmation", "proposed_operation_kinds", "status"],
      "properties": {
        "authority": {"$ref": "#/$defs/shortString"},
        "blocker": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["code", "mutation_count"],
              "properties": {
                "code": {"$ref": "#/$defs/shortString"},
                "mutation_count": {"type": "integer", "minimum": 0, "maximum": 16}
              }
            }
          ]
        },
        "operation": {"$ref": "#/$defs/operation"},
        "preauthorized_commit": {"type": "boolean"},
        "preauthorized_confirmation": {"type": "boolean"},
        "proposed_operation_kinds": {
          "type": "array", "minItems": 0, "maxItems": 4, "uniqueItems": true,
          "items": {"enum": ["create_asset_instance", "set_object_visibility", "set_reveal_bundle", "restore_snapshot"]}
        },
        "status": {"enum": ["accepted", "rejected"]}
      }
    },
    "trace": {
      "type": "object", "additionalProperties": false,
      "required": ["trace_id", "events"],
      "properties": {
        "trace_id": {"$ref": "#/$defs/shortString"},
        "events": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {"$ref": "#/$defs/traceEvent"}
        },
        "network_reads": {"type": "integer", "minimum": 0, "maximum": 16},
        "source_transaction_immutable": {"type": "boolean"}
      }
    },
    "traceEvent": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["canonical_state", "mutation_count", "scene_revision"],
          "properties": {
            "canonical_state": {"$ref": "#/$defs/shortString"},
            "mutation_count": {"type": "integer", "minimum": 0, "maximum": 16},
            "scene_revision": {"$ref": "#/$defs/revision"},
            "retry": {"$ref": "#/$defs/shortString"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["operation", "scene_revision", "transaction_id"],
          "properties": {
            "operation": {"$ref": "#/$defs/operation"},
            "scene_revision": {"$ref": "#/$defs/revision"},
            "transaction_id": {"$ref": "#/$defs/shortString"},
            "compensates_transaction_id": {"$ref": "#/$defs/shortString"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["case_id", "mutation_count", "scene_revision"],
          "properties": {
            "case_id": {"$ref": "#/$defs/shortString"},
            "mutation_count": {"type": "integer", "minimum": 0, "maximum": 16},
            "scene_revision": {"$ref": "#/$defs/revision"}
          }
        }
      ]
    }
  }
}
